/* 全局样式 - 与web端保持一致 */
page {
  background-color: #f0f2f5;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 白色卡片 - 主卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 小卡片 */
.card-sm {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 强调色文字 */
.text-primary {
  color: #2196F3;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

/* Flex 工具类 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 绿色圆形数字徽章 */
.num-badge {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  flex-shrink: 0;
}

/* 箭头 */
.arrow {
  font-size: 32rpx;
  color: #ccc;
  flex-shrink: 0;
}

/* 加载动画容器 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 领骑衫颜色圆点 */
.jersey-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.jersey-pink { background: linear-gradient(135deg, #ff69b4, #ff1493); }
.jersey-purple { background: linear-gradient(135deg, #9b59b6, #8e44ad); }
.jersey-blue { background: linear-gradient(135deg, #3498db, #2980b9); }
.jersey-white { background: linear-gradient(135deg, #ecf0f1, #bdc3c7); }

/* ========== 公共组件样式 ========== */

/* 统一卡片基础样式 */
.card-base {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  margin-bottom: 24rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #2196F3;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* 空状态提示 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-state-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-state-desc {
  font-size: 24rpx;
  color: #999;
}

/* 错误状态 + 重试按钮 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.error-state-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.error-state-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.retry-btn {
  background: #2196F3;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  border: none;
}

.retry-btn::after {
  border: none;
}

/* 骨架屏动画 */
.skeleton-item {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 8rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.skeleton-title {
  height: 36rpx;
  width: 60%;
  margin-bottom: 16rpx;
}

.skeleton-text {
  height: 24rpx;
  width: 80%;
  margin-bottom: 12rpx;
}

.skeleton-text-short {
  height: 24rpx;
  width: 40%;
  margin-bottom: 12rpx;
}

.skeleton-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 公共标签样式 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-blue {
  background: #e3f2fd;
  color: #1976D2;
}

.tag-green {
  background: #e8f5e9;
  color: #388E3C;
}

.tag-orange {
  background: #fff3e0;
  color: #F57C00;
}
