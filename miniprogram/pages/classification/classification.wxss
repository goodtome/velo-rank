/* pages/classification/classification.wxss */

/* ====== 骨架屏（复用 stage-results 样式） ====== */
.skeleton-container { padding: 24rpx; }
.skeleton-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.skeleton-item {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}
.skeleton-title { height: 40rpx; width: 60%; margin-bottom: 16rpx; }
.skeleton-text { height: 28rpx; width: 80%; }
.skeleton-text-short { height: 20rpx; width: 40%; }
@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ====== 错误状态 ====== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}
.error-state-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.error-state-text { font-size: 28rpx; color: #999; margin-bottom: 32rpx; }
.retry-btn {
  background: #2196F3;
  color: #fff;
  border-radius: 40rpx;
  padding: 16rpx 48rpx;
  font-size: 26rpx;
}

/* ====== 空状态 ====== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
  text-align: center;
}
.empty-state-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.empty-state-text { font-size: 28rpx; color: #999; margin-bottom: 8rpx; }
.empty-state-hint { font-size: 22rpx; color: #bbb; }

/* ====== 通用卡片 ====== */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

/* ====== 赛段信息头（复用 stage-results） ====== */
.stage-header {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}
.stage-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 12rpx;
}
.num-badge {
  background: #2196F3;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.stage-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}
.stage-type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.stage-route {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
}
.stage-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* ====== 分类榜头部 ====== */
.class-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 32rpx;
  color: #fff;
}
.class-header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.class-header-icon {
  font-size: 52rpx;
  line-height: 1;
}
.class-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}
.class-sub {
  font-size: 22rpx;
  opacity: 0.85;
}
.class-header-badge {
  background: rgba(255,255,255,0.25);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

/* 分类颜色（默认环意配色） */
.class-points {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  box-shadow: 0 4rpx 20rpx rgba(142, 68, 173, 0.3);
}
.class-mountains {
  background: linear-gradient(135deg, #3498db, #2980b9);
  box-shadow: 0 4rpx 20rpx rgba(41, 128, 185, 0.3);
}
.class-youth {
  background: linear-gradient(135deg, #7f8c8d, #636e72);
  box-shadow: 0 4rpx 20rpx rgba(99, 110, 114, 0.3);
}

/* 环法(TdF) 分类头部配色 */
.class-race-tdf.class-points {
  background: linear-gradient(135deg, #4CAF50, #2E7D32);
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.3);
}
.class-race-tdf.class-mountains {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  box-shadow: 0 4rpx 20rpx rgba(192, 57, 43, 0.3);
}

/* 环西(Vuelta) 分类头部配色 */
.class-race-vuelta.class-points {
  background: linear-gradient(135deg, #4CAF50, #2E7D32);
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.3);
}
.class-race-vuelta.class-mountains {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  box-shadow: 0 4rpx 20rpx rgba(192, 57, 43, 0.3);
}

/* ====== 排名列表 ====== */
.results-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}
.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

/* 表头 */
.result-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 4rpx;
  font-size: 22rpx;
  color: #999;
  font-weight: 600;
}
.rh-rank { width: 80rpx; }
.rh-rider { flex: 1; padding: 0 12rpx; }
.rh-team { width: 120rpx; text-align: center; }
.rh-value { width: 120rpx; text-align: right; }

/* 列表行 */
.result-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
  transition: background 0.15s;
}
.result-row-hover { background: #f8f9fa; }

/* 前三名高亮 */
.result-top3 {
  border-radius: 14rpx;
  padding: 20rpx 10rpx;
  margin: 6rpx 0;
  border-bottom: none;
}
.result-gold {
  background: linear-gradient(135deg, #fff8e1, #fff3e0);
  border-left: 4rpx solid #FFD700;
}
.result-silver {
  background: linear-gradient(135deg, #f5f5f5, #eeeeee);
  border-left: 4rpx solid #C0C0C0;
}
.result-bronze {
  background: linear-gradient(135deg, #fbe9e7, #ffccbc);
  border-left: 4rpx solid #CD7F32;
}

.rr-rank {
  width: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
  text-align: center;
}
.rr-rank-medal { font-size: 32rpx; }

.rr-rider {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 12rpx;
}
.rider-name {
  font-size: 26rpx;
  color: #222;
  font-weight: 500;
}
.rider-nat {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

.rr-team {
  width: 120rpx;
  font-size: 20rpx;
  color: #888;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rr-value {
  width: 120rpx;
  display: flex;
  justify-content: flex-end;
}
.value-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx;
  color: #2196F3;
  font-size: 26rpx;
}

/* 赛段类型标签 */
.tag-Flat { background: #e8f5e9; color: #388E3C; }
.tag-Hills { background: #fff3e0; color: #F57C00; }
.tag-Mountain { background: #fce4ec; color: #c62828; }
.tag-TTT { background: #e3f2fd; color: #1565C0; }
.tag-ITT { background: #e3f2fd; color: #1565C0; }
