<!-- 赛事百科页面 -->
<view class="encyclopedia-container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索术语..." bindinput="onSearchInput" value="{{searchKey}}" />
    <button class="search-btn" bindtap="onSearch">搜索</button>
  </view>
  
  <!-- 分类标签 -->
  <view class="category-tabs">
    <view class="tab {{activeCategory === 'all' ? 'active' : ''}}" bindtap="switchCategory" data-category="all">全部</view>
    <view class="tab {{activeCategory === 'rankings' ? 'active' : ''}}" bindtap="switchCategory" data-category="rankings">排名积分</view>
    <view class="tab {{activeCategory === 'jerseys' ? 'active' : ''}}" bindtap="switchCategory" data-category="jerseys">领骑荣誉</view>
    <view class="tab {{activeCategory === 'tactics' ? 'active' : ''}}" bindtap="switchCategory" data-category="tactics">战术技术</view>
    <view class="tab {{activeCategory === 'events' ? 'active' : ''}}" bindtap="switchCategory" data-category="events">赛事组织</view>
  </view>
  
  <!-- 术语列表 -->
  <view class="term-list">
    <view class="term-card" wx:for="{{filteredTerms}}" wx:key="id" bindtap="showTermDetail" data-id="{{item.id}}">
      <view class="term-header">
        <text class="term-name">{{item.name}}</text>
        <text class="term-english">{{item.english}}</text>
      </view>
      <view class="term-brief">{{item.brief}}</view>
      <view class="term-tags">
        <text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
      </view>
    </view>
  </view>
  
  <!-- 术语详情弹窗 -->
  <view class="term-detail-mask" wx:if="{{showDetail}}" bindtap="hideTermDetail">
    <view class="term-detail-dialog" catchtap="preventBubble">
      <view class="detail-header">
        <text class="detail-title">{{currentTerm.name}} ({{currentTerm.english}})</text>
        <view class="detail-close" bindtap="hideTermDetail">×</view>
      </view>
      <scroll-view scroll-y class="detail-content">
        <view class="detail-section">
          <text class="section-title">定义</text>
          <text class="section-content">{{currentTerm.definition}}</text>
        </view>
        
        <view class="detail-section">
          <text class="section-title">详细说明</text>
          <text class="section-content">{{currentTerm.description}}</text>
        </view>
        
        <view class="detail-section" wx:if="{{currentTerm.example}}">
          <text class="section-title">示例</text>
          <text class="section-content example">{{currentTerm.example}}</text>
        </view>
        
        <view class="detail-section" wx:if="{{currentTerm.relatedTerms.length > 0}}">
          <text class="section-title">相关术语</text>
          <view class="related-terms">
            <text class="related-term" wx:for="{{currentTerm.relatedTerms}}" wx:key="*this" bindtap="showRelatedTerm" data-term="{{item}}">{{item}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
