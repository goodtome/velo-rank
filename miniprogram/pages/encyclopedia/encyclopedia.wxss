/* 赛事百科页面样式 */
.encyclopedia-container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.search-btn {
  width: 160rpx;
  height: 80rpx;
  background: #1aad19;
  color: #fff;
  border-radius: 40rpx;
  margin-left: 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 10rpx;
  transition: all 0.3s;
}

.tab.active {
  background: #1aad19;
  color: #fff;
  font-weight: bold;
}

/* 术语列表 */
.term-list {
  margin-top: 20rpx;
}

.term-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  transition: transform 0.2s;
}

.term-card:active {
  transform: scale(0.98);
}

.term-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 15rpx;
}

.term-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 15rpx;
}

.term-english {
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}

.term-brief {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.term-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  font-size: 22rpx;
  color: #1aad19;
  background: rgba(26, 173, 25, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 术语详情弹窗 */
.term-detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.term-detail-dialog {
  width: 85%;
  max-height: 80vh;
  background: #fff;
  border-radius: 30rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.detail-close {
  font-size: 48rpx;
  color: #999;
  padding: 0 20rpx;
}

.detail-content {
  padding: 40rpx;
  max-height: 60vh;
}

.detail-section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #1aad19;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #1aad19;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}

.section-content.example {
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 10rpx;
  font-style: italic;
}

.related-terms {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-top: 15rpx;
}

.related-term {
  font-size: 26rpx;
  color: #1aad19;
  background: rgba(26, 173, 25, 0.1);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(26, 173, 25, 0.3);
}
