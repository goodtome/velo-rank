<!--pages/index/index.wxml-->
<view class="container">

  <!-- 骨架屏加载状态 -->
  <view wx:if="{{loading}}" class="skeleton-container">
    <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton-item skeleton-title"></view>
      <view class="skeleton-item skeleton-text"></view>
      <view class="skeleton-item skeleton-text-short"></view>
    </view>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{loadError}}" class="error-state">
    <text class="error-state-icon">😵</text>
    <text class="error-state-text">{{t('errorNetwork')}}</text>
    <button class="retry-btn" bindtap="retryLoad">{{t('retry')}}</button>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading && activeRaces.length === 0 && upcomingRaces.length === 0}}" class="empty-state">
    <text class="empty-state-icon">🚴</text>
    <text class="empty-state-text">{{t('noData')}}</text>
    <text class="empty-state-desc">{{t('pullToRefresh')}}</text>
  </view>

  <view wx:else>
    <!-- 进行中的赛事 -->
    <view wx:if="{{activeRaces.length > 0}}" class="section">
      <view class="section-header">
        <view class="section-dot dot-green"></view>
        <view class="section-title">{{t('todayRace')}}</view>
      </view>

      <view 
        wx:for="{{activeRaces}}" 
        wx:key="id"
        class="race-card"
        hover-class="race-card-hover"
        bindtap="onRaceTap"
        data-race-id="{{item.id}}"
      >
        <view class="race-status-badge">{{t('statusActive')}}</view>
        <view class="race-name">{{item.race_name_zh || item.race_name}}</view>
        <view class="race-meta">{{item.start_date}} {{t('to')}} {{item.end_date}}</view>
        <view class="race-meta">{{t('totalStages')}} {{item.total_stages}} {{t('stages')}}</view>
        <view class="race-arrow">></view>
      </view>
    </view>

    <!-- 近期赛事 -->
    <view class="section">
      <view class="section-header">
        <view class="section-dot dot-blue"></view>
        <view class="section-title">{{t('upcomingRace')}}</view>
      </view>

      <view 
        wx:for="{{upcomingRaces}}" 
        wx:key="id"
        class="race-card"
        hover-class="race-card-hover"
        bindtap="onRaceTap"
        data-race-id="{{item.id}}"
      >
        <view class="race-name">{{item.race_name_zh || item.race_name}}</view>
        <view class="race-meta">{{item.start_date}} {{t('to')}} {{item.end_date}}</view>
        <view class="race-meta">{{t('totalStages')}} {{item.total_stages}} {{t('stages')}}</view>
        <view class="race-arrow">></view>
      </view>
    </view>
  </view>
</view>
