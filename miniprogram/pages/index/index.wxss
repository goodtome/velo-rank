/* pages/index/index.wxss */

.season-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.season-value {
  font-size: 32rpx;
  color: #e74c3c;
  font-weight: bold;
  padding: 8rpx 16rpx;
  background-color: #2a2a3e;
  border-radius: 8rpx;
}

/* 赛事卡片 */
.race-card {
  margin-bottom: 20rpx;
  position: relative;
  transition: all 0.3s;
}

.race-card:active {
  transform: scale(0.98);
  background-color: #f5f5f5;
}

.race-card.active {
  border-left: 6rpx solid #e74c3c;
}

.race-status {
  font-size: 24rpx;
  color: #27ae60;
  margin-bottom: 8rpx;
}

.race-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.race-meta {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
}

.tap-hint {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #2a2a3e;
  text-align: right;
  font-size: 22rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #8a8a8a;
}

.section {
  margin-bottom: 30rpx;
}
