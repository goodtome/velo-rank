/* pages/index/index.wxss */

/* 区域 */
.section {
  margin-bottom: 36rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.live-dot {
  width: 16rpx;
  height: 16rpx;
  background: #e74c3c;
  border-radius: 50%;
  margin-right: 12rpx;
  animation: live-pulse 1.5s infinite;
}

@keyframes live-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.dot-gray { background: #999; }

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

/* ====== Hero大卡片（进行中赛事）====== */
.hero-card {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 52, 96, 0.3);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}

.hero-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 50%;
}

.hero-card-hover {
  transform: scale(0.985);
  box-shadow: 0 4rpx 16rpx rgba(15, 52, 96, 0.2);
}

.hero-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.hero-badge {
  background: #e74c3c;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  letter-spacing: 2rpx;
}

.hero-race-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  flex: 1;
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 28rpx;
}

.hero-stages {
  background: rgba(255, 255, 255, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

/* 领骑衫行 */
.jerseys-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.jersey-item {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 45%;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 16rpx;
}

.jersey-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
}

.jersey-pink { background: linear-gradient(135deg, #ff69b4, #ff1493); }
.jersey-purple { background: linear-gradient(135deg, #9b59b6, #8e44ad); }
.jersey-blue { background: linear-gradient(135deg, #3498db, #2980b9); }
.jersey-white { background: linear-gradient(135deg, #ecf0f1, #bdc3c7); }

.jersey-info {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.jersey-rider-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.jersey-team-name {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.hero-link {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ====== 近期完赛列表 ====== */
.race-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.15s, background 0.15s;
}

.race-card-hover {
  background: #f8f9fa;
  transform: scale(0.985);
}

.race-card-left {
  flex: 1;
  overflow: hidden;
}

.race-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.race-card-meta {
  font-size: 24rpx;
  color: #999;
}

.race-card-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.race-card-stages {
  font-size: 24rpx;
  color: #2196F3;
  background: #e3f2fd;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.race-card-arrow {
  font-size: 28rpx;
  color: #ccc;
}
