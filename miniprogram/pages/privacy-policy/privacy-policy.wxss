/* 隐私政策页面样式 */
.page-container {
  background-color: #f0f2f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #1aad19, #129611);
  padding: 60rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 8rpx;
}

.header-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 内容卡片 */
.content-card {
  background-color: #ffffff;
  margin: 24rpx 32rpx 0;
  border-radius: 24rpx;
  padding: 0 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 引言 */
.intro-text {
  padding: 28rpx 0;
}

.intro-text text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 区块头部 */
.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 0 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 区块内容 */
.section-body {
  padding: 20rpx 0 28rpx;
}

.body-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

/* 信息条目 */
.info-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #1aad19;
  margin-top: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.info-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.7;
}

/* 不收集信息网格 */
.no-collect-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.no-collect-item {
  width: 50%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
}

.no-collect-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.no-collect-text {
  font-size: 28rpx;
  color: #666;
}

/* 使用方式条目 */
.usage-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.usage-item:last-child {
  margin-bottom: 0;
}

.usage-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #1aad19;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.usage-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  flex: 1;
}

/* 底部信息 */
.footer-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 24rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.footer-date {
  font-size: 22rpx;
  color: #ccc;
}
