<view class="profile-page">
  <!-- 用户头像区域 -->
  <view class="header-section">
    <view class="avatar-wrapper">
      <view class="avatar-circle">
        <text class="avatar-icon">👤</text>
      </view>
    </view>
    <text class="nickname">骑行爱好者</text>
    <text class="welcome-text">欢迎使用正一领骑</text>
  </view>

  <!-- 应用统计 -->
  <view class="card-base stats-card" bindtap="{{loadError ? 'retryLoad' : ''}}">
    <view class="stats-row">
      <view class="stats-item">
        <text class="stats-value text-primary">{{raceCount}}</text>
        <text class="stats-label">赛事</text>
      </view>
      <view class="stats-item">
        <text class="stats-value text-primary">{{riderCount}}</text>
        <text class="stats-label">车手</text>
      </view>
      <view class="stats-item">
        <text class="stats-value text-primary">{{teamCount}}</text>
        <text class="stats-label">车队</text>
      </view>
    </view>
    <view wx:if="{{loadError}}" class="stats-error-hint">
      <text>{{errorMessage || '数据加载失败'}} · 点击重试</text>
    </view>
  </view>

  <!-- 功能菜单列表 -->
  <view class="card-base menu-card">
    <view class="menu-item" bindtap="goToCalendar">
      <view class="menu-left">
        <text class="menu-icon">📅</text>
        <text class="menu-text">赛事日历</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToRaceArchive">
      <view class="menu-left">
        <text class="menu-icon">🗂️</text>
        <text class="menu-text">赛事归档</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToFavorites">
      <view class="menu-left">
        <text class="menu-icon">★</text>
        <text class="menu-text">我的关注</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToPushSettings">
      <view class="menu-left">
        <text class="menu-icon">🔔</text>
        <text class="menu-text">推送设置</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToFeedback">
      <view class="menu-left">
        <text class="menu-icon">💬</text>
        <text class="menu-text">帮助和反馈</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{isAdminToolsVisible}}" class="menu-divider"></view>
    <view wx:if="{{isAdminToolsVisible}}" class="menu-item" bindtap="goToAdminSync">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">管理同步</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToSearch">
      <view class="menu-left">
        <text class="menu-icon">🔍</text>
        <text class="menu-text">搜索历史</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToHome">
      <view class="menu-left">
        <text class="menu-icon">📊</text>
        <text class="menu-text">赛事数据</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToEncyclopedia">
      <view class="menu-left">
        <text class="menu-icon">📖</text>
        <text class="menu-text">赛事百科</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="clearCache">
      <view class="menu-left">
        <text class="menu-icon">🗑️</text>
        <text class="menu-text">清除缓存</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToPrivacyPolicy">
      <view class="menu-left">
        <text class="menu-icon">🔒</text>
        <text class="menu-text">隐私政策</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToUserAgreement">
      <view class="menu-left">
        <text class="menu-icon">📄</text>
        <text class="menu-text">用户协议</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item menu-item-danger" bindtap="deleteAccount">
      <view class="menu-left">
        <text class="menu-icon">🗙</text>
        <text class="menu-text">注销账号</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="toggleAbout">
      <view class="menu-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于</text>
      </view>
      <text class="arrow">{{showAbout ? '^' : '›'}}</text>
    </view>
    <!-- 关于应用展开区域 -->
    <view class="about-expand" wx:if="{{showAbout}}">
      <view class="about-divider"></view>
      <view class="about-content">
        <text class="about-name">正一领骑 / velo-rank</text>
        <text class="about-version">V2.0.0</text>
        <text class="about-desc">专业自行车赛事成绩查询</text>
      </view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer-section">
    <text class="footer-name">正一领骑 / velo-rank V2.0.0</text>
    <text class="footer-desc">专业自行车赛事成绩查询</text>
  </view>
</view>
