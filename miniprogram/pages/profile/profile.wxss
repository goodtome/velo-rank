/* 页面容器 */
.profile-page {
  background-color: #f0f2f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 头部区域 - 蓝色渐变背景 */
.header-section {
  background: linear-gradient(180deg, #2196F3, #1976D2);
  padding: 60rpx 0 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 0 0 32rpx 32rpx;
}

/* 头像包装 */
.avatar-wrapper {
  margin-bottom: 24rpx;
}

/* 头像圆形 */
.avatar-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 64rpx;
  color: #ffffff;
}

/* 昵称 */
.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

/* 欢迎文本 */
.welcome-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 统计卡片 - 负margin与头部重叠 */
.stats-card {
  margin: -40rpx 24rpx 24rpx 24rpx;
  padding: 32rpx 0;
}

/* 统计行 - 3列flex */
.stats-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

.stats-error-hint {
  text-align: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 22rpx;
  color: #e74c3c;
}

/* 菜单卡片 */
.menu-card {
  margin: 0 24rpx 24rpx 24rpx;
  padding: 0;
  overflow: hidden;
}

/* 菜单项 */
.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.menu-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
}

.menu-item-danger .menu-text {
  color: #e74c3c;
}

/* 菜单分割线 */
.menu-divider {
  height: 1rpx;
  background-color: #e8e8e8;
  margin: 0 28rpx;
}

/* 关于展开区域 */
.about-expand {
  padding: 0 28rpx;
}

.about-divider {
  height: 1rpx;
  background-color: #e8e8e8;
}

.about-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}

.about-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.about-version {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.about-desc {
  font-size: 24rpx;
  color: #999;
}

/* 底部信息 */
.footer-section {
  text-align: center;
  padding: 40rpx;
  margin-top: 20rpx;
}

.footer-name {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.footer-desc {
  display: block;
  font-size: 22rpx;
  color: #bbb;
}
