/* 推送设置页面样式 */
.settings-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #1aad19, #12b365);
  color: #fff;
  padding: 40rpx 30rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.page-desc {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
}

/* 设置区块 */
.setting-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding: 30rpx 30rpx 10rpx;
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-info {
  flex: 1;
  margin-right: 20rpx;
}

.setting-label {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.setting-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 时间选择器 */
.time-picker-group {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 20rpx;
}

.time-picker-item {
  flex: 1;
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 10rpx;
}

.time-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.time-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.dnd-tip {
  padding: 20rpx 30rpx 30rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 推送频率选项 */
.frequency-options {
  display: flex;
  padding: 20rpx 30rpx 30rpx;
  gap: 15rpx;
}

.frequency-item {
  flex: 1;
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 15rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.frequency-item.active {
  background: rgba(26, 173, 25, 0.1);
  border-color: #1aad19;
}

.frequency-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.frequency-item.active .frequency-name {
  color: #1aad19;
}

.frequency-desc {
  display: block;
  font-size: 20rpx;
  color: #999;
}

/* 测试按钮 */
.test-btn {
  margin: 30rpx;
  background: #1aad19;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 25rpx 0;
}

/* 提示信息 */
.tip-section {
  display: flex;
  align-items: flex-start;
  margin: 20rpx 30rpx;
  padding: 20rpx;
  background: #fff8e1;
  border-radius: 15rpx;
  border-left: 8rpx solid #ffc107;
}

.tip-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
