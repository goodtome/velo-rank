<!--pages/race-calendar/race-calendar.wxml-->
<view class="container">
  <!-- 顶部月份切换 -->
  <view class="header">
    <view class="month-switcher">
      <view class="arrow-btn" bindtap="prevMonth">
        <text class="arrow-icon">‹</text>
      </view>
      <text class="month-text">{{monthText}}</text>
      <view class="arrow-btn" bindtap="nextMonth">
        <text class="arrow-icon">›</text>
      </view>
    </view>
    <view class="today-btn" bindtap="goToToday">今天</view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-bar" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 日历星期头 -->
  <view class="week-header">
    <text wx:for="{{weekDays}}" wx:key="index"
          class="week-day {{index === 0 || index === 6 ? 'weekend' : ''}}">{{item}}</text>
  </view>

  <!-- 日历网格 -->
  <view class="calendar-grid">
    <view
      wx:for="{{calendarDays}}"
      wx:key="index"
      class="day-cell {{item.isCurrentMonth ? '' : 'other-month'}} {{item.isToday ? 'today' : ''}} {{item.races.length > 0 ? 'has-races' : ''}} {{selectedDate === item.date ? 'selected' : ''}}"
      bindtap="tapDay"
      data-day="{{item}}"
    >
      <text class="day-number">{{item.day}}</text>
      <view class="race-dots" wx:if="{{item.raceDots.length > 0}}">
        <view wx:for="{{item.raceDots}}" wx:for-item="dot" wx:key="index"
              class="race-dot" style="background: {{dot.color}}"></view>
      </view>
    </view>
  </view>

  <!-- 图例 -->
  <view class="legend">
    <view class="legend-item">
      <view class="legend-dot" style="background: #07c160"></view>
      <text class="legend-text">进行中</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot" style="background: #f1c40f"></view>
      <text class="legend-text">大环赛</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot" style="background: #e74c3c"></view>
      <text class="legend-text">世巡赛</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot" style="background: #f39c12"></view>
      <text class="legend-text">职业赛</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot" style="background: #9b59b6"></view>
      <text class="legend-text">女子世巡</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot" style="background: #e67e22"></view>
      <text class="legend-text">世锦赛</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot" style="background: #95a5a6"></view>
      <text class="legend-text">洲际赛</text>
    </view>
  </view>

  <!-- 当日赛事列表 -->
  <view class="race-list" wx:if="{{selectedDate && selectedRaces.length > 0}}">
    <view class="section-title">{{selectedDate}} 赛事 ({{selectedRaces.length}})</view>
    <view
      wx:for="{{selectedRaces}}"
      wx:key="id"
      class="race-card"
      bindtap="goToRace"
      data-id="{{item.id}}"
    >
      <view class="race-status status-{{item.status}}">
        {{item.status === 'ongoing' ? '● 进行中' : item.status === 'upcoming' ? '○ 即将开始' : '— 已结束'}}
      </view>
      <view class="race-info">
        <text class="race-name">{{item.race_name_zh || item.race_name}}</text>
        <view class="race-meta">
          <text class="race-category">{{item.category === 'Grand Tour' ? '大环赛' : item.category === 'WorldTour' ? '世巡赛' : item.category === 'ProSeries' ? '职业赛' : item.category === 'Continental' ? '洲际赛' : item.category === 'World Championships' ? '世锦赛' : item.category === 'Women-WorldTour' ? '女子世巡' : item.category === 'Women-ProSeries' ? '女子职业' : item.category || '赛事'}}</text>
          <text class="race-dates">{{item.start_date}} ~ {{item.end_date}}</text>
        </view>
      </view>
      <view class="race-action" catchtap="addToCalendar" data-race="{{item}}">
        <text class="add-icon">📅</text>
      </view>
    </view>
  </view>

  <!-- 选中无赛事 -->
  <view class="empty-tip" wx:if="{{selectedDate && selectedRaces.length === 0}}">
    <text class="empty-icon">🚴</text>
    <text class="empty-text">{{selectedDate}} 暂无赛事</text>
  </view>

  <!-- 即将开始的赛事 -->
  <view class="upcoming-section">
    <view class="section-title">即将开始</view>
    <view wx:if="{{upcomingRaces.length > 0}}">
      <view
        wx:for="{{upcomingRaces}}"
        wx:key="id"
        class="race-card upcoming-card"
        bindtap="goToRace"
        data-id="{{item.id}}"
      >
        <view class="race-countdown">{{item.countdownText}}</view>
        <view class="race-info">
          <text class="race-name">{{item.race_name_zh || item.race_name}}</text>
          <text class="race-date">{{item.start_date}} ~ {{item.end_date}}</text>
        </view>
        <view class="race-category-tag {{item.category === 'Grand Tour' ? 'gt' : ''}}">
          {{item.category === 'Grand Tour' ? '大环赛' : item.category === 'WorldTour' ? '世巡赛' : item.category === 'ProSeries' ? '职业赛' : item.category === 'Continental' ? '洲际赛' : item.category === 'World Championships' ? '世锦赛' : item.category === 'Women-WorldTour' ? '女子世巡' : item.category === 'Women-ProSeries' ? '女子职业' : '赛事'}}
        </view>
      </view>
    </view>
    <view class="empty-tip" wx:else>
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无即将开始的赛事</text>
    </view>
  </view>
</view>
