/* pages/race-calendar/race-calendar.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 顶部月份切换 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 20rpx;
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.month-switcher {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.arrow {
  font-size: 40rpx;
  padding: 10rpx 20rpx;
  color: #07c160;
}

.month-text {
  font-size: 36rpx;
  font-weight: bold;
}

.today-btn {
  background: #07c160;
  color: white;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

/* 星期头 */
.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  background: white;
  padding: 20rpx 0;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.week-day {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
}

/* 日历网格 */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
  background: white;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  position: relative;
  background: #fafafa;
}

.day-cell.other-month {
  opacity: 0.3;
}

.day-cell.today {
  background: #07c160;
  color: white;
}

.day-number {
  font-size: 32rpx;
  font-weight: bold;
}

.race-dot {
  width: 12rpx;
  height: 12rpx;
  background: #07c160;
  border-radius: 50%;
  position: absolute;
  bottom: 8rpx;
}

.today .race-dot {
  background: white;
}

.race-count {
  font-size: 20rpx;
  color: #07c160;
  position: absolute;
  top: 4rpx;
  right: 8rpx;
}

.today .race-count {
  color: white;
}

/* 赛事列表 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 8rpx solid #07c160;
}

.race-list {
  margin-bottom: 30rpx;
}

.race-card {
  background: white;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.race-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.race-status-ongoing {
  background: #e8f5e9;
  color: #07c160;
}

.race-status-upcoming {
  background: #e3f2fd;
  color: #1976d2;
}

.race-status-finished {
  background: #f5f5f5;
  color: #999;
}

.race-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.race-name {
  font-size: 30rpx;
  font-weight: bold;
}

.race-category {
  font-size: 24rpx;
  color: #666;
}

.race-date {
  font-size: 24rpx;
  color: #999;
}

.race-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.add-icon {
  font-size: 40rpx;
  color: #07c160;
}

.add-text {
  font-size: 20rpx;
  color: #666;
}

/* 倒计时 */
.race-countdown {
  font-size: 28rpx;
  color: #ff9800;
  font-weight: bold;
  white-space: nowrap;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

/* 即将开始区域 */
.upcoming-section {
  background: white;
  padding: 30rpx;
  border-radius: 16rpx;
}
