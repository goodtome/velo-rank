<!--pages/race-detail/race-detail.wxml-->
<view class="container">

  <!-- 骨架屏加载状态 -->
  <view wx:if="{{loading}}" class="skeleton-container">
    <!-- 赛事信息骨架 -->
    <view class="skeleton-card">
      <view class="skeleton-item skeleton-title"></view>
      <view class="skeleton-item skeleton-text"></view>
      <view class="skeleton-item skeleton-text-short"></view>
    </view>
    <!-- 赛段列表骨架 -->
    <view class="skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view style="display:flex;align-items:center;">
        <view class="skeleton-item" style="width:56rpx;height:56rpx;border-radius:50%;margin-right:20rpx;"></view>
        <view style="flex:1;">
          <view class="skeleton-item skeleton-text"></view>
          <view class="skeleton-item skeleton-text-short"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{loadError}}" class="error-state">
    <text class="error-state-icon">😵</text>
    <text class="error-state-text">{{t('errorNetwork')}}</text>
    <button class="retry-btn" bindtap="retryLoad">{{t('retry')}}</button>
  </view>

  <view wx:else>
    <!-- 赛事信息头部卡片 -->
    <view class="race-card card">
      <view class="race-name">{{race.race_name_zh || race.race_name}}</view>
      <view class="race-meta">{{race.start_date}} {{t('to')}} {{race.end_date}}</view>
      <view class="race-stats">
        <view class="stat">
          <view class="stat-val">{{race.total_stages}}</view>
          <view class="stat-label">{{t('stages')}}</view>
        </view>
        <view class="stat">
          <view class="stat-val">{{race.total_distance}}</view>
          <view class="stat-label">{{t('km')}}</view>
        </view>
      </view>
    </view>

    <!-- 赛段列表 -->
    <view class="section-title">{{t('stageList').replace('{count}', stages.length)}}</view>

    <!-- 空赛段列表提示 -->
    <view wx:if="{{stages.length === 0}}" class="empty-state">
      <text class="empty-state-icon">📋</text>
      <text class="empty-state-text">{{t('noStageData')}}</text>
    </view>

    <view class="stage-list" wx:if="{{stages.length > 0}}">
      <view 
        wx:for="{{stages}}" 
        wx:key="id"
        class="stage-item"
        hover-class="stage-item-hover"
        bindtap="onStageTap"
        data-stage-id="{{item.id}}"
        data-stage-number="{{item.stage_number}}"
      >
        <view class="stage-left">
          <view class="num-badge">{{item.stage_number}}</view>
          <view class="stage-info">
            <view class="stage-route">{{item.start_city}} → {{item.end_city}}</view>
            <view class="stage-meta">{{item.date}} · {{item.distance_km}}km</view>
          </view>
        </view>
        <view class="arrow">></view>
      </view>
    </view>

    <!-- GC入口 - 橙黄色渐变卡片 -->
    <view class="gc-card" hover-class="gc-card-hover" bindtap="onGCTap">
      <view class="gc-left">
        <view class="gc-icon">🏆</view>
        <view class="gc-text">
          <view class="gc-title">{{t('gcTitle')}}</view>
          <view class="gc-sub">{{t('gcSub')}}</view>
        </view>
      </view>
      <view class="arrow-white">></view>
    </view>

  </view>
</view>
