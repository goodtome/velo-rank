/* pages/race-detail/race-detail.wxss */

/* 赛事信息头部卡片 */
.race-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(33,150,243,0.08);
}

.race-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 6rpx;
}

.race-name-en {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.race-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.race-date {
  font-size: 24rpx;
  color: #888;
}

.race-stats {
  display: flex;
  justify-content: flex-start;
  gap: 60rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #2196F3;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* ====== 领骑衫区域 ====== */
.jerseys-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.jerseys-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.jersey-card {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 45%;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 16rpx;
}

.jersey-circle-lg {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 14rpx;
}

.jersey-pink { background: linear-gradient(135deg, #ff69b4, #ff1493); }
.jersey-purple { background: linear-gradient(135deg, #9b59b6, #8e44ad); }
.jersey-blue { background: linear-gradient(135deg, #3498db, #2980b9); }
.jersey-white { background: linear-gradient(135deg, #ecf0f1, #bdc3c7); }
.jersey-BLUE_SPRINT { background: linear-gradient(135deg, #3498db, #2980b9); }
.jersey-WHITE_YOUTH { background: linear-gradient(135deg, #ecf0f1, #bdc3c7); }

.jersey-detail {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
}

.jersey-type-label {
  font-size: 20rpx;
  color: #999;
}

.jersey-rider {
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.jersey-team {
  font-size: 20rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.jersey-extra {
  flex-shrink: 0;
  margin-left: 8rpx;
}

.jersey-points {
  font-size: 22rpx;
  color: #2196F3;
  font-weight: 600;
}

/* ====== 赛段列表 ====== */
.stage-list {
  margin-bottom: 24rpx;
}

.stage-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  transition: all 0.15s;
}

.stage-item-hover {
  background: #f5f5f5;
  transform: scale(0.985);
}

.stage-left {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.stage-info {
  flex: 1;
  overflow: hidden;
  margin-left: 20rpx;
}

.stage-route {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stage-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  flex-wrap: wrap;
}

.stage-type-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.tag-Flat { background: #e8f5e9; color: #388E3C; }
.tag-Hills { background: #fff3e0; color: #F57C00; }
.tag-Mountain { background: #fce4ec; color: #c62828; }
.tag-TTT { background: #e3f2fd; color: #1565C0; }
.tag-ITT { background: #e3f2fd; color: #1565C0; }

.arrow {
  font-size: 30rpx;
  color: #ccc;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ====== GC入口 ====== */
.gc-card {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(255,152,0,0.25);
  transition: all 0.15s;
}

.gc-card-hover {
  opacity: 0.85;
  transform: scale(0.985);
}

.gc-left {
  display: flex;
  align-items: center;
}

.gc-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.gc-text {
  display: flex;
  flex-direction: column;
}

.gc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.gc-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

.arrow-white {
  font-size: 32rpx;
  color: rgba(255,255,255,0.8);
  flex-shrink: 0;
}

/* ====== 分类榜入口卡片 ====== */
.clf-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  transition: all 0.15s;
}
.clf-card-hover {
  opacity: 0.85;
  transform: scale(0.985);
}

.clf-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.clf-icon {
  font-size: 40rpx;
  line-height: 1;
}

.clf-text {
  display: flex;
  flex-direction: column;
}

.clf-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.clf-sub {
  font-size: 20rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 2rpx;
}

.clf-points {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  box-shadow: 0 4rpx 16rpx rgba(142, 68, 173, 0.2);
}
.clf-mountains {
  background: linear-gradient(135deg, #3498db, #2980b9);
  box-shadow: 0 4rpx 16rpx rgba(41, 128, 185, 0.2);
}
.clf-youth {
  background: linear-gradient(135deg, #7f8c8d, #636e72);
  box-shadow: 0 4rpx 16rpx rgba(99, 110, 114, 0.2);
}
