/* pages/race-detail/race-detail.wxss */

/* 赛事信息头部卡片 */
.cache-notice {
  margin: 0 24rpx 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #fff7e6;
  color: #a46000;
  font-size: 22rpx;
}

.race-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(33,150,243,0.08);
}

.race-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 6rpx;
}

.race-name-en {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.race-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.race-date {
  font-size: 24rpx;
  color: #888;
}

.race-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 78rpx;
  min-width: 0;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  box-shadow: inset 0 0 0 1rpx rgba(33, 150, 243, 0.08);
  overflow: hidden;
}

.stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 5rpx;
  background: linear-gradient(90deg, #42a5f5, #1565c0);
}

.stat-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  background: rgba(33, 150, 243, 0.08);
}

.stat-content {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.stat-label {
  font-size: 18rpx;
  color: #6b7280;
}

.stat-value {
  font-size: 22rpx;
  font-weight: 700;
  color: #1565c0;
  line-height: 1.4;
}

.stat-stages::before,
.stat-stages .stat-icon {
  background: linear-gradient(180deg, rgba(66, 165, 245, 0.14), rgba(21, 101, 192, 0.12));
}

.stat-distance::before,
.stat-distance .stat-icon {
  background: linear-gradient(180deg, rgba(255, 183, 77, 0.18), rgba(239, 108, 0, 0.12));
}

.stat-recorded::before,
.stat-recorded .stat-icon {
  background: linear-gradient(180deg, rgba(102, 187, 106, 0.16), rgba(46, 125, 50, 0.12));
}

.stat-category::before,
.stat-category .stat-icon {
  background: linear-gradient(180deg, rgba(171, 71, 188, 0.16), rgba(106, 27, 154, 0.12));
}

/* ====== 赛事数据可视化 ====== */
.viz-card {
  background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(33,150,243,0.08);
}

.viz-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.viz-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7f8c8d;
}

.viz-badge {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(33, 150, 243, 0.12);
  color: #1565c0;
  font-size: 20rpx;
  font-weight: 600;
}

.viz-difficulty {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(33,150,243,0.08), rgba(26,173,25,0.06));
  box-shadow: inset 0 0 0 1rpx rgba(33, 150, 243, 0.06);
}

.viz-difficulty-score {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #42a5f5 0%, #1565c0 100%);
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 24rpx rgba(21, 101, 192, 0.24);
}

.viz-difficulty-score-easy {
  background: linear-gradient(180deg, #66bb6a 0%, #2e7d32 100%);
  box-shadow: 0 12rpx 24rpx rgba(46, 125, 50, 0.24);
}

.viz-difficulty-score-medium {
  background: linear-gradient(180deg, #ffb74d 0%, #ef6c00 100%);
  box-shadow: 0 12rpx 24rpx rgba(239, 108, 0, 0.24);
}

.viz-difficulty-score-high {
  background: linear-gradient(180deg, #ff7043 0%, #d84315 100%);
  box-shadow: 0 12rpx 24rpx rgba(216, 67, 21, 0.26);
}

.viz-difficulty-score-extreme {
  background: linear-gradient(180deg, #ef5350 0%, #b71c1c 100%);
  box-shadow: 0 12rpx 24rpx rgba(183, 28, 28, 0.28);
}

.viz-difficulty-body {
  flex: 1;
  min-width: 0;
}

.viz-difficulty-title {
  font-size: 22rpx;
  color: #7f8c8d;
  margin-bottom: 6rpx;
}

.viz-difficulty-level {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 6rpx;
}

.viz-difficulty-level-easy {
  color: #2e7d32;
}

.viz-difficulty-level-medium {
  color: #ef6c00;
}

.viz-difficulty-level-high {
  color: #d84315;
}

.viz-difficulty-level-extreme {
  color: #b71c1c;
}

.viz-difficulty-reason {
  font-size: 22rpx;
  line-height: 1.6;
  color: #5f6b7a;
}

.viz-breakdown {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.viz-breakdown-item {
  padding: 14rpx 16rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: inset 0 0 0 1rpx rgba(33, 150, 243, 0.06);
}

.viz-breakdown-item-easy {
  box-shadow: inset 0 0 0 1rpx rgba(46, 125, 50, 0.12);
}

.viz-breakdown-item-medium {
  box-shadow: inset 0 0 0 1rpx rgba(239, 108, 0, 0.12);
}

.viz-breakdown-item-high {
  box-shadow: inset 0 0 0 1rpx rgba(216, 67, 21, 0.14);
}

.viz-breakdown-item-extreme {
  box-shadow: inset 0 0 0 1rpx rgba(183, 28, 28, 0.16);
}

.viz-breakdown-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.viz-breakdown-label-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.viz-breakdown-icon {
  font-size: 24rpx;
  line-height: 1;
}

.viz-breakdown-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #2c3e50;
}

.viz-breakdown-score {
  font-size: 18rpx;
  color: #7f8c8d;
}

.viz-breakdown-score-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.viz-breakdown-toggle {
  font-size: 18rpx;
  color: #1565c0;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(21, 101, 192, 0.08);
}

.viz-breakdown-track {
  height: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(33, 150, 243, 0.08);
}

.viz-breakdown-fill {
  height: 100%;
  border-radius: 999rpx;
}

.viz-breakdown-distance {
  background: linear-gradient(90deg, #42a5f5, #1565c0);
}

.viz-breakdown-terrain {
  background: linear-gradient(90deg, #ff7043, #d84315);
}

.viz-breakdown-density {
  background: linear-gradient(90deg, #66bb6a, #2e7d32);
}

.viz-breakdown-fill-easy {
  background: linear-gradient(90deg, #66bb6a, #2e7d32);
}

.viz-breakdown-fill-medium {
  background: linear-gradient(90deg, #ffb74d, #ef6c00);
}

.viz-breakdown-fill-high {
  background: linear-gradient(90deg, #ff7043, #d84315);
}

.viz-breakdown-fill-extreme {
  background: linear-gradient(90deg, #ef5350, #b71c1c);
}

.viz-breakdown-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #5f6b7a;
}

.viz-breakdown-detail {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed rgba(33, 150, 243, 0.14);
}

.viz-breakdown-detail-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 6rpx;
}

.viz-breakdown-detail-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: #1565c0;
  flex-shrink: 0;
}

.viz-breakdown-detail-text {
  flex: 1;
  font-size: 20rpx;
  line-height: 1.55;
  color: #4b5563;
}

.viz-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.viz-stat {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  border-radius: 16rpx;
  padding: 14rpx 14rpx 12rpx;
  box-shadow: 0 6rpx 18rpx rgba(33, 150, 243, 0.06), inset 0 0 0 1rpx rgba(33, 150, 243, 0.08);
  min-width: 0;
  min-height: 84rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.viz-stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, #42a5f5, #1e88e5);
}

.viz-stat-line {
  font-size: 21rpx;
  font-weight: 800;
  color: #1565c0;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.viz-timeline-card .viz-stats {
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.viz-timeline-card .viz-stat {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-height: 80rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
  box-shadow: 0 6rpx 18rpx rgba(33, 150, 243, 0.06), inset 0 0 0 1rpx rgba(33, 150, 243, 0.08);
}

.viz-timeline-card .viz-stat::before {
  background: linear-gradient(90deg, #42a5f5, #1e88e5);
}

.viz-timeline-card .viz-stat-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  background: rgba(33, 150, 243, 0.1);
  flex-shrink: 0;
}

.viz-timeline-card .viz-stat-content {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.viz-timeline-card .viz-stat-val {
  font-size: 24rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #1565c0;
}

.viz-timeline-card .viz-stat-label {
  font-size: 18rpx;
  line-height: 1.2;
  color: #7f8c8d;
}

.viz-timeline-card .viz-stat-rest .viz-stat-icon {
  background: rgba(46, 125, 50, 0.1);
}

.viz-timeline-card .viz-stat-rest .viz-stat-val {
  color: #2e7d32;
}

.viz-timeline-card .viz-stat-density .viz-stat-icon {
  background: rgba(255, 183, 77, 0.16);
}

.viz-timeline-card .viz-stat-density .viz-stat-val {
  color: #ef6c00;
}

.viz-timeline-card .viz-stat-long .viz-stat-icon {
  background: rgba(255, 112, 67, 0.12);
}

.viz-timeline-card .viz-stat-long .viz-stat-val {
  color: #d84315;
}

.viz-timeline-card .viz-stat-total .viz-stat-icon {
  background: rgba(156, 39, 176, 0.1);
}

.viz-timeline-card .viz-stat-total .viz-stat-val {
  color: #7b1fa2;
}

.viz-chart-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #34495e;
  margin-bottom: 14rpx;
}

.viz-scroll {
  width: 100%;
  margin-bottom: 24rpx;
}

.viz-bars {
  display: flex;
  align-items: flex-end;
  gap: 18rpx;
  min-height: 280rpx;
  padding: 12rpx 4rpx 0;
}

.viz-bar-item {
  width: 108rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.viz-bar-item-hover {
  transform: translateY(-2rpx);
  opacity: 0.96;
}

.viz-bar-track {
  width: 76rpx;
  height: 200rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  margin-bottom: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(33,150,243,0.08) 0%, rgba(33,150,243,0.03) 100%);
  overflow: hidden;
}

.viz-bar-fill {
  width: 100%;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #42a5f5 0%, #1e88e5 48%, #1565c0 100%);
  box-shadow: 0 8rpx 18rpx rgba(21, 101, 192, 0.22);
}

.viz-bar-label-top {
  font-size: 20rpx;
  font-weight: 600;
  color: #1565c0;
  margin-bottom: 4rpx;
}

.viz-bar-marker {
  max-width: 100rpx;
  margin: 2rpx 0 6rpx;
  padding: 4rpx 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: #9c4d00;
  background: #fff3e0;
  font-size: 18rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.viz-bar-label {
  font-size: 18rpx;
  line-height: 1.3;
  color: #34495e;
  text-align: center;
  min-height: 44rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.viz-bar-type {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #7f8c8d;
}

.viz-type-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.viz-type-item {
  background: #fff;
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  box-shadow: inset 0 0 0 1rpx rgba(33, 150, 243, 0.06);
}

.viz-type-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.viz-type-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #34495e;
}

.viz-type-count {
  font-size: 20rpx;
  color: #7f8c8d;
}

.viz-type-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(33, 150, 243, 0.08);
  overflow: hidden;
}

.viz-type-fill {
  height: 100%;
  border-radius: 999rpx;
}

.viz-type-Flat { background: linear-gradient(90deg, #66bb6a, #2e7d32); }
.viz-type-Hills { background: linear-gradient(90deg, #ffb74d, #f57c00); }
.viz-type-Mountain { background: linear-gradient(90deg, #ef5350, #c62828); }
.viz-type-ITT { background: linear-gradient(90deg, #42a5f5, #1565c0); }
.viz-type-TTT { background: linear-gradient(90deg, #ab47bc, #6a1b9a); }
.viz-type-Unknown { background: linear-gradient(90deg, #90a4ae, #607d8b); }

.viz-timeline {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.viz-timeline-item {
  display: flex;
  align-items: stretch;
}

.viz-timeline-item-hover .viz-timeline-body {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 20rpx rgba(33, 150, 243, 0.08), inset 0 0 0 1rpx rgba(33, 150, 243, 0.08);
}

.viz-timeline-item-hover .viz-timeline-dot {
  box-shadow: 0 0 0 8rpx rgba(33, 150, 243, 0.1);
}

.viz-timeline-marker {
  width: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.viz-timeline-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(33, 150, 243, 0.08);
}

.viz-timeline-line {
  width: 3rpx;
  flex: 1;
  margin-top: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(33,150,243,0.22), rgba(33,150,243,0.06));
}

.viz-timeline-body {
  flex: 1;
  margin-left: 12rpx;
  padding: 14rpx 14rpx 12rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.05), inset 0 0 0 1rpx rgba(33, 150, 243, 0.06);
  position: relative;
  overflow: hidden;
}

.viz-timeline-body::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, #42a5f5, #1e88e5);
}

.viz-timeline-body.viz-type-Flat::before {
  background: linear-gradient(90deg, #66bb6a, #2e7d32);
}

.viz-timeline-body.viz-type-Hills::before {
  background: linear-gradient(90deg, #ffb74d, #f57c00);
}

.viz-timeline-body.viz-type-Mountain::before {
  background: linear-gradient(90deg, #ef5350, #c62828);
}

.viz-timeline-body.viz-type-ITT::before {
  background: linear-gradient(90deg, #42a5f5, #1565c0);
}

.viz-timeline-body.viz-type-TTT::before {
  background: linear-gradient(90deg, #ab47bc, #6a1b9a);
}

.viz-timeline-body.viz-type-Unknown::before {
  background: linear-gradient(90deg, #90a4ae, #607d8b);
}

.viz-timeline-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 6rpx;
}

.viz-timeline-head-left {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.viz-timeline-head-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.viz-timeline-stage {
  font-size: 22rpx;
  font-weight: 700;
  color: #1565c0;
  line-height: 1.2;
  white-space: nowrap;
}

.viz-timeline-date {
  font-size: 18rpx;
  color: #7f8c8d;
}

.viz-timeline-kind {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 17rpx;
  font-weight: 700;
  color: #1565c0;
  background: rgba(33, 150, 243, 0.1);
}

.viz-timeline-arrow {
  font-size: 28rpx;
  line-height: 1;
  color: #c4cbd4;
}

.viz-timeline-body.viz-type-Flat .viz-timeline-kind {
  color: #2e7d32;
  background: rgba(46, 125, 50, 0.1);
}

.viz-timeline-body.viz-type-Hills .viz-timeline-kind {
  color: #ef6c00;
  background: rgba(255, 183, 77, 0.18);
}

.viz-timeline-body.viz-type-Mountain .viz-timeline-kind {
  color: #d84315;
  background: rgba(255, 112, 67, 0.12);
}

.viz-timeline-body.viz-type-ITT .viz-timeline-kind {
  color: #1565c0;
  background: rgba(66, 165, 245, 0.12);
}

.viz-timeline-body.viz-type-TTT .viz-timeline-kind {
  color: #7b1fa2;
  background: rgba(171, 71, 188, 0.12);
}

.viz-timeline-body.viz-type-Unknown .viz-timeline-kind {
  color: #607d8b;
  background: rgba(144, 164, 174, 0.14);
}

.viz-timeline-route {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.viz-timeline-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: center;
  margin-top: 2rpx;
}

.viz-timeline-distance,
.viz-timeline-gap,
.viz-timeline-chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 17rpx;
  color: #5f6b7a;
  background: rgba(33, 150, 243, 0.08);
}

.viz-timeline-gap {
  background: rgba(26, 173, 25, 0.08);
  color: #166534;
}

.viz-timeline-empty {
  margin-top: 4rpx;
  padding: 28rpx 0 20rpx;
}

/* ====== 领骑衫区域 ====== */
.jerseys-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.jerseys-grid {
  display: flex;
  flex-wrap: wrap;
}

.jersey-card {
  display: flex;
  align-items: center;
  width: 48%;
  margin-right: 4%;
  margin-bottom: 16rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.jersey-card:nth-child(2n) {
  margin-right: 0;
}

.jersey-circle-lg {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 14rpx;
}

.jersey-detail {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
}

.jersey-type-label {
  font-size: 20rpx;
  color: #999;
}

.jersey-rider {
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.jersey-team {
  font-size: 20rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.jersey-extra {
  flex-shrink: 0;
  margin-left: 8rpx;
}

.jersey-points {
  font-size: 22rpx;
  color: #2196F3;
  font-weight: 600;
}

.arrow {
  font-size: 30rpx;
  color: #ccc;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ====== GC入口 ====== */
.gc-card {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(255,152,0,0.25);
  transition: all 0.15s;
}

.gc-card-hover {
  opacity: 0.85;
  transform: scale(0.985);
}

.gc-left {
  display: flex;
  align-items: center;
}

.gc-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.gc-text {
  display: flex;
  flex-direction: column;
}

.gc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.gc-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

.arrow-white {
  font-size: 32rpx;
  color: rgba(255,255,255,0.8);
  flex-shrink: 0;
}

/* ====== 分类榜入口卡片 ====== */
.clf-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  transition: all 0.15s;
}
.clf-card-hover {
  opacity: 0.85;
  transform: scale(0.985);
}

.clf-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.clf-icon {
  font-size: 40rpx;
  line-height: 1;
}

.clf-text {
  display: flex;
  flex-direction: column;
}

.clf-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.clf-sub {
  font-size: 20rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 2rpx;
}

.clf-points {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  box-shadow: 0 4rpx 16rpx rgba(142, 68, 173, 0.2);
}
.clf-mountains {
  background: linear-gradient(135deg, #3498db, #2980b9);
  box-shadow: 0 4rpx 16rpx rgba(41, 128, 185, 0.2);
}
.clf-youth {
  background: linear-gradient(135deg, #7f8c8d, #636e72);
  box-shadow: 0 4rpx 16rpx rgba(99, 110, 114, 0.2);
}

/* 环法(TdF) 分类卡片配色覆盖 */
.clf-race-tdf .clf-points {
  background: linear-gradient(135deg, #4CAF50, #2E7D32);
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.25);
}
.clf-race-tdf .clf-mountains {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  box-shadow: 0 4rpx 16rpx rgba(192, 57, 43, 0.25);
}
.clf-race-tdf .clf-youth {
  background: linear-gradient(135deg, #7f8c8d, #636e72);
  box-shadow: 0 4rpx 16rpx rgba(99, 110, 114, 0.2);
}

/* 环西(Vuelta) 分类卡片配色覆盖 */
.clf-race-vuelta .clf-points {
  background: linear-gradient(135deg, #4CAF50, #2E7D32);
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.25);
}
.clf-race-vuelta .clf-mountains {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  box-shadow: 0 4rpx 16rpx rgba(192, 57, 43, 0.25);
}
.clf-race-vuelta .clf-youth {
  background: linear-gradient(135deg, #7f8c8d, #636e72);
  box-shadow: 0 4rpx 16rpx rgba(99, 110, 114, 0.2);
}

/* ====== 车队成绩榜独立入口 ====== */
.team-classification-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1e88e5 0%, #1565c0 50%, #0d47a1 100%);
  box-shadow: 0 10rpx 28rpx rgba(21, 101, 192, 0.24);
}

.team-classification-card-hover {
  opacity: 0.92;
  transform: scale(0.985);
}

.team-classification-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.team-classification-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
  margin-right: 20rpx;
  font-size: 36rpx;
  flex-shrink: 0;
}

.team-classification-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.team-classification-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.team-classification-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.3;
}

.team-classification-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 18rpx;
}

.team-classification-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  margin-right: 14rpx;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  font-weight: 700;
  color: #0d47a1;
  background: rgba(255, 255, 255, 0.9);
}
