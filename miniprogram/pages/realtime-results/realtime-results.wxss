/* 实时成绩页面样式 */
.realtime-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 赛事信息栏 */
.race-info-bar {
  background: linear-gradient(135deg, #1aad19, #12b365);
  color: #fff;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 173, 25, 0.3);
}

.race-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.stage-info {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 15rpx;
}

.race-status {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.race-status.live {
  background: rgba(255, 68, 68, 0.3);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff4444;
  margin-right: 10rpx;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* 实时时间栏 */
.time-bar {
  display: flex;
  justify-content: space-around;
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.elapsed-time, .remaining-distance, .leader-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.time-label, .distance-label, .leader-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.time-value, .distance-value, .leader-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.leader-value {
  color: #1aad19;
}

/* 标签切换栏 */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 25rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #1aad19;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #1aad19;
  border-radius: 3rpx;
}

.tab-english {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.tab-item.active .tab-english {
  color: #1aad19;
}

/* 排名列表 */
.ranking-list {
  height: calc(100vh - 400rpx);
  padding: 20rpx;
}

.ranking-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.header-update {
  font-size: 22rpx;
  color: #999;
}

/* 车手卡片 */
.rider-card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 25rpx 30rpx;
  margin-bottom: 15rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  transition: all 0.2s;
}

.rider-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.rider-card.leader {
  background: linear-gradient(135deg, #fff9e6, #fff3cc);
  border-left: 8rpx solid #ffd700;
}

.rider-card.favorite {
  border-right: 8rpx solid #1aad19;
}

.rank {
  width: 80rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
}

.rider-card.leader .rank {
  color: #ffd700;
}

.rider-info {
  flex: 1;
  margin: 0 20rpx;
}

.rider-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.team-name {
  font-size: 24rpx;
  color: #999;
}

.rider-age {
  font-size: 22rpx;
  color: #1aad19;
  margin-top: 4rpx;
}

.time-info, .points-info {
  text-align: right;
  min-width: 150rpx;
}

.time-gap {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.rank-change {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.rank-change.up {
  color: #1aad19;
}

.rank-change.down {
  color: #ff4444;
}

.rank-change.same {
  color: #999;
}

.points-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #1aad19;
}

.favorite-btn {
  margin-left: 20rpx;
  font-size: 36rpx;
  color: #ffd700;
}

/* 关注车手快捷跳转 */
.favorite-shortcut {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.1);
  z-index: 100;
}

.shortcut-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 15rpx;
  display: block;
}

.favorite-list {
  white-space: nowrap;
}

.favorite-item {
  display: inline-block;
  background: rgba(26, 173, 25, 0.1);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  margin-right: 15rpx;
  font-size: 26rpx;
}

.favorite-rank {
  color: #1aad19;
  font-weight: bold;
  margin-right: 10rpx;
}

.favorite-name {
  color: #333;
}

/* 连接状态指示器 */
.connection-status {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 15rpx;
  text-align: center;
  font-size: 24rpx;
  z-index: 101;
}

.connection-status.connected {
  background: rgba(26, 173, 25, 0.9);
  color: #fff;
}

.connection-status.connecting {
  background: rgba(255, 170, 0, 0.9);
  color: #fff;
}

.connection-status.disconnected {
  background: rgba(255, 68, 68, 0.9);
  color: #fff;
}
