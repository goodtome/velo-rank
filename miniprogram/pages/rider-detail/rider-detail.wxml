<!--pages/rider-detail/rider-detail.wxml-->
<view class="container">

  <!-- 骨架屏加载状态 -->
  <view wx:if="{{loading}}" class="skeleton-container">
    <view class="skeleton-header">
      <view class="skeleton-avatar skeleton-item"></view>
      <view class="skeleton-header-info">
        <view class="skeleton-item skeleton-title"></view>
        <view class="skeleton-item skeleton-text"></view>
        <view class="skeleton-item skeleton-text-short"></view>
      </view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-item skeleton-title"></view>
      <view wx:for="{{[1,2,3,4]}}" wx:key="*this" style="display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #f0f0f0;">
        <view class="skeleton-item" style="width:120rpx;height:24rpx;"></view>
        <view class="skeleton-item" style="width:200rpx;height:24rpx;"></view>
      </view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-item skeleton-title"></view>
      <view class="skeleton-item skeleton-text"></view>
    </view>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{loadError}}" class="error-state">
    <text class="error-state-icon">😵</text>
    <text class="error-state-text">{{t('errorNetwork')}}</text>
    <button class="retry-btn" bindtap="retryLoad">{{t('retry')}}</button>
  </view>

  <!-- 数据为空 -->
  <view wx:elif="{{!rider}}" class="empty-state">
    <text class="empty-state-icon">🚴</text>
    <text class="empty-state-text">{{t('riderNotFound')}}</text>
  </view>

  <!-- 正常内容 -->
  <view wx:else>

    <!-- 头部卡片 -->
    <view class="header-card">
      <view class="header-main">
        <!-- 头像 -->
        <view class="avatar-wrap">
          <image wx:if="{{rider.photo_url}}" class="avatar" src="{{rider.photo_url}}" mode="aspectFill"></image>
          <view wx:else class="avatar avatar-placeholder">🚴</view>
        </view>
        <!-- 名称信息 -->
        <view class="header-info">
          <text class="rider-name-zh">{{rider.rider_name_zh || rider.rider_name}}</text>
          <text wx:if="{{rider.rider_name_zh && rider.rider_name}}" class="rider-name-en">{{rider.rider_name}}</text>
          <view wx:if="{{rider.nationality}}" class="nationality-tag">{{rider.nationality}}</view>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="card-base info-card">
      <view class="section-title">{{t('basicInfo')}}</view>

      <view class="info-item">
        <text class="info-label">{{t('nationality')}}</text>
        <text class="info-value">{{rider.nationality || '-'}}</text>
      </view>

      <view wx:if="{{rider.birth_date}}" class="info-item">
        <text class="info-label">{{t('birthDate')}}</text>
        <text class="info-value">{{rider.birth_date}}</text>
      </view>

      <view wx:if="{{rider.height_cm}}" class="info-item">
        <text class="info-label">{{t('height')}}</text>
        <text class="info-value">{{rider.height_cm}} cm</text>
      </view>

      <view wx:if="{{rider.weight_kg}}" class="info-item">
        <text class="info-label">{{t('weight')}}</text>
        <text class="info-value">{{rider.weight_kg}} kg</text>
      </view>

      <view wx:if="{{rider.uci_id}}" class="info-item">
        <text class="info-label">{{t('uciId')}}</text>
        <text class="info-value">{{rider.uci_id}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">{{t('status')}}</text>
        <text class="info-value">{{rider.is_retired ? t('retired') : t('active')}}</text>
      </view>
    </view>

    <!-- 所属车队 -->
    <view wx:if="{{rider.team_id}}" class="card-base team-card" bindtap="goToTeam" data-id="{{rider.team_id}}" hover-class="team-card-hover">
      <view class="section-title">{{t('belongTeam')}}</view>
      <view class="team-row">
        <view class="team-info">
          <text class="team-name-zh">{{rider.team_name_zh || rider.team_name}}</text>
          <text wx:if="{{rider.team_name_en}}" class="team-name-en">{{rider.team_name_en}}</text>
        </view>
        <view class="team-right">
          <text wx:if="{{rider.uci_code}}" class="tag tag-blue">{{rider.uci_code}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 历史成绩 -->
    <view class="card-base results-card">
      <view class="section-title">{{t('raceResults')}}</view>
      
      <!-- 加载中 -->
      <view wx:if="{{resultsLoading}}" class="results-loading">
        <view wx:for="{{[1,2,3]}}" wx:key="*this" class="result-skeleton">
          <view class="skeleton-item" style="width:60rpx;height:24rpx;"></view>
          <view class="skeleton-item" style="width:200rpx;height:24rpx;"></view>
          <view class="skeleton-item" style="width:100rpx;height:24rpx;"></view>
        </view>
      </view>

      <!-- 无数据 -->
      <view wx:elif="{{results.length === 0}}" class="empty-results">
        <text class="empty-text">{{t('noResults')}}</text>
      </view>

      <!-- 成绩列表 -->
      <view wx:else>
        <view wx:for="{{results}}" wx:key="rank" class="result-item">
          <view class="result-left">
            <text class="result-rank">{{item.rank}}</text>
            <view class="result-info">
              <text class="result-race">{{item.race_name_zh || item.race_name}}</text>
              <text class="result-stage">Stage {{item.stage_number}}: {{item.stage_name}}</text>
            </view>
          </view>
          <view class="result-right">
            <text class="result-gap">{{item.time_gap}}</text>
            <text wx:if="{{item.stage_type}}" class="tag tag-{{item.stage_type === 'Flat' ? 'green' : item.stage_type === 'Hills' ? 'orange' : 'red'}}">{{item.stage_type}}</text>
          </view>
        </view>
      </view>
    </view>

  </view>
</view>
