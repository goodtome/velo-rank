<!--pages/rider-detail/rider-detail.wxml-->
<view class="container">

  <!-- 骨架屏加载状态 -->
  <view wx:if="{{loading}}" class="skeleton-container">
    <view class="skeleton-header">
      <view class="skeleton-avatar skeleton-item"></view>
      <view class="skeleton-header-info">
        <view class="skeleton-item skeleton-title"></view>
        <view class="skeleton-item skeleton-text"></view>
        <view class="skeleton-item skeleton-text-short"></view>
      </view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-item skeleton-title"></view>
      <view wx:for="{{[1,2,3,4]}}" wx:key="*this" style="display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #f0f0f0;">
        <view class="skeleton-item" style="width:120rpx;height:24rpx;"></view>
        <view class="skeleton-item" style="width:200rpx;height:24rpx;"></view>
      </view>
    </view>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{loadError}}" class="error-state">
    <text class="error-state-icon">😵</text>
    <text class="error-state-text">{{errorMessage || '网络错误，请检查网络连接'}}</text>
    <button class="retry-btn" bindtap="retryLoad">重试</button>
  </view>

  <!-- 数据为空 -->
  <view wx:elif="{{!rider}}" class="empty-state">
    <text class="empty-state-icon">🚴</text>
    <text class="empty-state-text">未找到车手信息</text>
  </view>

  <!-- 正常内容 -->
  <view wx:else>

    <!-- 头部卡片 -->
    <view class="header-card">
      <view class="header-main">
        <view class="avatar-wrap">
          <image wx:if="{{rider.photo_url}}" class="avatar" src="{{rider.photo_url}}" mode="aspectFill" lazy-load></image>
          <view wx:else class="avatar avatar-placeholder">🚴</view>
        </view>
        <view class="header-info">
          <text class="rider-name-zh">{{riderName.zh || riderName.en}}</text>
          <text wx:if="{{riderName.zh && riderName.en}}" class="rider-name-en">{{riderName.en}}</text>
          <view wx:if="{{rider.nationality}}" class="nationality-tag">{{nationalityZh}}</view>
        </view>
      </view>
    </view>

    <!-- 统计卡片（新增） -->
    <view wx:if="{{stats}}" class="card-base stats-card">
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-value stats-highlight">{{stats.total_races || 0}}</text>
          <text class="stat-label">参赛</text>
        </view>
        <view class="stat-item">
          <text class="stat-value stats-gold">{{stats.wins || 0}}</text>
          <text class="stat-label">🏆 冠军</text>
        </view>
        <view class="stat-item">
          <text class="stat-value stats-silver">{{stats.podiums || 0}}</text>
          <text class="stat-label">🥈🥉 领奖台</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{stats.top10 || 0}}</text>
          <text class="stat-label">前10名</text>
        </view>
      </view>
      <!-- 领骑衫历史 -->
      <view wx:if="{{stats.jerseys && stats.jerseys.length > 0}}" class="jersey-history">
        <text class="jersey-label">🛡️ 曾穿领骑衫：</text>
        <text wx:for="{{stats.jerseys}}" wx:for-item="j" wx:key="jersey_type" class="jersey-tag jersey-tag-{{j.jersey_type}}">{{j._jersey_name_zh || j.jersey_type}}</text>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="card-base info-card">
      <view class="section-title">基本信息</view>
      <view wx:if="{{riderName.zh}}" class="info-item">
        <text class="info-label">中文名</text>
        <text class="info-value">{{riderName.zh}}</text>
      </view>
      <view wx:if="{{riderName.en}}" class="info-item">
        <text class="info-label">英文名</text>
        <text class="info-value">{{riderName.en}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">国籍</text>
        <text class="info-value">{{nationalityZh || '-'}}</text>
      </view>
      <view wx:if="{{rider.birth_date}}" class="info-item">
        <text class="info-label">出生日期</text>
        <text class="info-value">{{rider.birth_date}}</text>
      </view>
      <view wx:if="{{rider.height_cm}}" class="info-item">
        <text class="info-label">身高</text>
        <text class="info-value">{{rider.height_cm}} cm</text>
      </view>
      <view wx:if="{{rider.weight_kg}}" class="info-item">
        <text class="info-label">体重</text>
        <text class="info-value">{{rider.weight_kg}} kg</text>
      </view>
      <view wx:if="{{rider.uci_id}}" class="info-item">
        <text class="info-label">UCI ID</text>
        <text class="info-value">{{rider.uci_id}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">状态</text>
        <text class="info-value">{{statusText}}</text>
      </view>
    </view>

    <!-- 所属车队 -->
    <view wx:if="{{rider.team_id}}" class="card-base team-card" bindtap="goToTeam" data-id="{{rider.team_id}}" hover-class="team-card-hover">
      <view class="section-title">所属车队</view>
      <view class="team-row">
        <view class="team-info">
          <text class="team-name-zh">{{rider.team_name_zh || teamName}}</text>
          <text wx:if="{{rider.team_name_zh && teamName}}" class="team-name-en">{{teamName}}</text>
        </view>
        <view class="team-right">
          <text wx:if="{{rider.uci_code}}" class="tag tag-blue">{{rider.uci_code}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 历史成绩 -->
    <view class="card-base results-card">
      <view class="section-title">历史成绩</view>
      
      <view wx:if="{{resultsLoading}}" class="results-loading">
        <view wx:for="{{[1,2,3]}}" wx:key="*this" class="result-skeleton">
          <view class="skeleton-item" style="width:60rpx;height:24rpx;"></view>
          <view class="skeleton-item" style="width:200rpx;height:24rpx;"></view>
          <view class="skeleton-item" style="width:100rpx;height:24rpx;"></view>
        </view>
      </view>

      <view wx:elif="{{results.length === 0}}" class="empty-results">
        <text class="empty-text">暂无成绩数据</text>
      </view>

      <view wx:else>
        <view wx:for="{{results}}" wx:key="stage_rank" class="result-item {{item.isPodium ? 'result-podium' : ''}}">
          <view class="result-rank-wrap">
            <text wx:if="{{item.medal}}" class="result-medal">{{item.medal}}</text>
            <text class="result-rank {{item.stage_rank === 1 ? 'rank-gold' : item.stage_rank === 2 ? 'rank-silver' : item.stage_rank === 3 ? 'rank-bronze' : ''}}">{{item.stage_rank}}</text>
          </view>
          <view class="result-info">
            <text class="result-race">{{item.race_name_zh || item.race_name}}</text>
            <text class="result-stage">S{{item.stage_number}}: {{item.stage_name}}</text>
            <text wx:if="{{item.team_name}}" class="result-team">{{item.team_name_zh || item.team_name}}</text>
          </view>
          <view class="result-right">
            <text class="result-gap">{{item.timeStr}}</text>
            <text wx:if="{{item.stage_type}}" class="tag tag-{{item.typeColor}}">{{item.stage_type}}</text>
          </view>
        </view>
      </view>
    </view>

  </view>
</view>
