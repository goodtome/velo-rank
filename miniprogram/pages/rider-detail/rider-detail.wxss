/* pages/rider-detail/rider-detail.wxss */

/* 骨架屏 */
.skeleton-container {
  padding: 0;
}

.skeleton-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2196F3, #1976D2);
  border-radius: 0 0 32rpx 32rpx;
  padding: 48rpx 32rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.skeleton-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.skeleton-header-info {
  flex: 1;
}

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #2196F3, #1976D2);
  border-radius: 0 0 32rpx 32rpx;
  padding: 48rpx 32rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.header-main {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  margin-right: 32rpx;
  flex-shrink: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: rgba(255, 255, 255, 0.2);
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rider-name-zh {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}

.rider-name-en {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
  line-height: 1.3;
}

.nationality-tag {
  display: inline-block;
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 12rpx;
}

.favorite-btn {
  align-self: flex-start;
  min-width: 132rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 18rpx 0 0 0;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #1565c0;
  font-size: 24rpx;
  font-weight: 600;
}

.favorite-btn::after {
  border: none;
}

.favorite-btn-active {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}

/* 基本信息 */
.info-card {
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
}

/* 车队卡片 */
.team-card {
  margin-bottom: 24rpx;
  cursor: pointer;
}

.team-card-hover {
  background: #f8f9fa;
}

.team-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.team-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.team-name-zh {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.team-name-en {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.team-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 历史成绩 */
.results-card {
  margin-bottom: 24rpx;
}

.results-loading {
  padding: 24rpx 0;
}

.result-skeleton {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.empty-results {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  color: #999;
  font-size: 28rpx;
}

.result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-left {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 16rpx;
}

.result-rank {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  min-width: 48rpx;
  text-align: center;
}

.result-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.result-race {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.result-stage {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.result-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-gap {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

/* 标签颜色 */
.tag-green {
  background: #e8f5e9;
  color: #2e7d32;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.tag-orange {
  background: #fff3e0;
  color: #e65100;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.tag-red {
  background: #ffebee;
  color: #c62828;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.tag-purple {
  background: #f3e5f5;
  color: #6a1b9a;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.tag-blue {
  background: #e3f2fd;
  color: #1565c0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

/* 统计卡片 */
.stats-card {
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.stats-highlight {
  color: #1565c0;
}

.stats-gold {
  color: #f57f17;
}

.stats-silver {
  color: #6d4c41;
}

/* 领骑衫历史 */
.jersey-history {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.jersey-label {
  font-size: 24rpx;
  color: #666;
}

.jersey-tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  text-transform: uppercase;
}

.jersey-tag-pink, .jersey-tag-PINK {
  background: #fce4ec;
  color: #c62828;
}

.jersey-tag-purple, .jersey-tag-PURPLE {
  background: #f3e5f5;
  color: #6a1b9a;
}

.jersey-tag-blue, .jersey-tag-BLUE, .jersey-tag-BLUE_SPRINT {
  background: #e3f2fd;
  color: #1565c0;
}

.jersey-tag-white, .jersey-tag-WHITE, .jersey-tag-WHITE_YOUTH {
  background: #f5f5f5;
  color: #616161;
  border: 1rpx solid #e0e0e0;
}

/* 环法令骑衫标签 */
.jersey-tag-yellow, .jersey-tag-YELLOW {
  background: #fff8e1;
  color: #f57f17;
}

.jersey-tag-green, .jersey-tag-GREEN {
  background: #e8f5e9;
  color: #2e7d32;
}

.jersey-tag-polka_dot, .jersey-tag-POLKA_DOT, .jersey-tag-POLKADOT {
  background: #ffebee;
  color: #c62828;
}

/* 环西领骑衫标签 */
.jersey-tag-red, .jersey-tag-RED {
  background: #ffebee;
  color: #c62828;
}

/* 车手表现可视化 */
.rider-viz-card {
  margin-bottom: 24rpx;
}

.rider-insights-card {
  margin-bottom: 24rpx;
}

.rider-insights-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.rider-insights-item {
  display: flex;
  flex-direction: column;
  min-height: 86rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
}

.rider-insights-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #1565c0;
}

.rider-insights-label,
.rider-insights-subtitle {
  margin-top: 6rpx;
  color: #7f8c8d;
  font-size: 20rpx;
}

.rider-insights-green .rider-insights-value { color: #2e7d32; }
.rider-insights-purple .rider-insights-value { color: #7b1fa2; }
.rider-insights-gold .rider-insights-value { color: #f57f17; }

.rider-insights-section {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f3;
}

.rider-insights-subtitle {
  margin: 0 0 10rpx;
  font-weight: 700;
  color: #34495e;
  font-size: 24rpx;
}

.rider-season-row,
.rider-form-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
}

.rider-season-row:last-child,
.rider-form-row:last-child {
  border-bottom: none;
}

.rider-season-year {
  min-width: 72rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #1565c0;
}

.rider-season-meta,
.rider-season-best,
.rider-form-stage {
  color: #7f8c8d;
  font-size: 20rpx;
}

.rider-season-win {
  color: #f57f17;
  font-weight: 700;
}

.rider-season-best {
  margin-left: auto;
  color: #34495e;
}

.rider-form-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.rider-form-race {
  overflow: hidden;
  color: #34495e;
  font-size: 24rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rider-form-rank {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f3f5;
  color: #5f6b7a;
  font-size: 22rpx;
  font-weight: 800;
}

.rider-form-rank-podium { color: #1565c0; background: #e3f2fd; }
.rider-form-rank-win { color: #a75b00; background: #fff3cd; }

.rider-viz-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.rider-viz-summary-item {
  min-height: 92rpx;
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #f8f9fa;
  box-shadow: inset 0 0 0 1rpx rgba(33, 150, 243, 0.06);
}

.rider-viz-summary-value {
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 800;
  color: #1565c0;
}

.rider-viz-summary-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #7f8c8d;
}

.rider-viz-summary-green .rider-viz-summary-value {
  color: #2e7d32;
}

.rider-viz-summary-gold .rider-viz-summary-value {
  color: #f57f17;
}

.rider-viz-summary-purple .rider-viz-summary-value {
  color: #7b1fa2;
}

.rider-viz-chart-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #34495e;
  margin-bottom: 14rpx;
}

.rider-viz-scroll {
  width: 100%;
  margin-bottom: 22rpx;
}

.rider-viz-bars {
  min-height: 238rpx;
  display: flex;
  align-items: flex-end;
  gap: 18rpx;
  padding: 8rpx 4rpx 0;
}

.rider-viz-bar-item {
  width: 84rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rider-viz-rank {
  min-height: 28rpx;
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #5f6b7a;
}

.rider-viz-rank-win {
  color: #f57f17;
}

.rider-viz-rank-podium {
  color: #1565c0;
}

.rider-viz-bar-track {
  width: 54rpx;
  height: 164rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  background: rgba(33, 150, 243, 0.08);
}

.rider-viz-bar-fill {
  width: 100%;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #90a4ae, #607d8b);
}

.rider-viz-bar-win {
  background: linear-gradient(180deg, #ffca28, #f57f17);
}

.rider-viz-bar-podium {
  background: linear-gradient(180deg, #42a5f5, #1565c0);
}

.rider-viz-stage {
  margin-top: 8rpx;
  font-size: 19rpx;
  color: #7f8c8d;
}

.rider-viz-types {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rider-viz-type-item {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
}

.rider-viz-type-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.rider-viz-type-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #34495e;
}

.rider-viz-type-count {
  font-size: 20rpx;
  color: #7f8c8d;
}

.rider-viz-type-track {
  height: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(33, 150, 243, 0.08);
}

.rider-viz-type-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #42a5f5, #1565c0);
}

/* 成绩排名高亮 */
.result-rank-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 64rpx;
}

.result-medal {
  font-size: 28rpx;
  line-height: 1;
}

.rank-gold {
  color: #f57f17 !important;
  font-size: 32rpx !important;
}

.rank-silver {
  color: #78909c !important;
}

.rank-bronze {
  color: #8d6e63 !important;
}

.result-podium {
  background: linear-gradient(90deg, rgba(255, 215, 0, 0.05), transparent);
  border-radius: 8rpx;
  padding-left: 8rpx !important;
  padding-right: 8rpx !important;
}

/* 成绩中的车队名 */
.result-team {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}
