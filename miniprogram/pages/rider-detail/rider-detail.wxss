/* pages/rider-detail/rider-detail.wxss */

/* 骨架屏 */
.skeleton-container {
  padding: 0;
}

.skeleton-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2196F3, #1976D2);
  border-radius: 0 0 32rpx 32rpx;
  padding: 48rpx 32rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.skeleton-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.skeleton-header-info {
  flex: 1;
}

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #2196F3, #1976D2);
  border-radius: 0 0 32rpx 32rpx;
  padding: 48rpx 32rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.header-main {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  margin-right: 32rpx;
  flex-shrink: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: rgba(255, 255, 255, 0.2);
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rider-name-zh {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}

.rider-name-en {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
  line-height: 1.3;
}

.nationality-tag {
  display: inline-block;
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 12rpx;
}

/* 基本信息 */
.info-card {
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
}

/* 车队卡片 */
.team-card {
  margin-bottom: 24rpx;
  cursor: pointer;
}

.team-card-hover {
  background: #f8f9fa;
}

.team-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.team-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.team-name-zh {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.team-name-en {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.team-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 历史成绩 */
.results-card {
  margin-bottom: 24rpx;
}

.results-loading {
  padding: 24rpx 0;
}

.result-skeleton {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.empty-results {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  color: #999;
  font-size: 28rpx;
}

.result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-left {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 16rpx;
}

.result-rank {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  min-width: 48rpx;
  text-align: center;
}

.result-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.result-race {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.result-stage {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.result-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-gap {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

/* 标签颜色 */
.tag-green {
  background: #e8f5e9;
  color: #2e7d32;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.tag-orange {
  background: #fff3e0;
  color: #e65100;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.tag-red {
  background: #ffebee;
  color: #c62828;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}
