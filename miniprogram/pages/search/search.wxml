<!-- 搜索栏 -->
<view class="search-bar">
  <view class="search-input-wrap">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      type="text"
      placeholder="{{t('searchPlaceholder')}}"
      value="{{keyword}}"
      bindinput="onInput"
      confirm-type="search"
    />
    <view wx:if="{{keyword}}" class="clear-btn" bindtap="clearInput">
      <text>✕</text>
    </view>
  </view>
</view>

<!-- Tab切换 -->
<view class="tab-bar">
  <view
    class="tab-item {{searchType === 'riders' ? 'tab-active' : ''}}"
    data-type="riders"
    bindtap="switchTab"
  >
    <text>{{t('searchRiders')}}</text>
  </view>
  <view
    class="tab-item {{searchType === 'teams' ? 'tab-active' : ''}}"
    data-type="teams"
    bindtap="switchTab"
  >
    <text>{{t('searchTeams')}}</text>
  </view>
</view>

<!-- 搜索历史（未搜索时显示） -->
<view class="container" wx:if="{{!searched && !loading && !keyword && searchHistory.length > 0}}">
  <view class="history-header">
    <text class="history-title">{{t('searchHistoryTitle')}}</text>
    <text class="history-clear" bindtap="clearHistory">{{t('clearHistory')}}</text>
  </view>
  <view class="history-list">
    <view
      class="history-tag"
      wx:for="{{searchHistory}}"
      wx:key="*this"
      data-keyword="{{item}}"
      bindtap="tapHistory"
    >
      <text>{{item}}</text>
    </view>
  </view>
</view>

<!-- 初始状态 -->
<view class="initial-state" wx:if="{{!searched && !loading && !keyword && searchHistory.length === 0}}">
  <text class="initial-icon">🔍</text>
  <text class="initial-text">{{t('initialText')}}</text>
</view>

<!-- 加载中 -->
<view class="loading-container" wx:if="{{loading}}">
  <view class="loading-spinner"></view>
  <text class="loading-text">{{t('searching')}}</text>
</view>

<!-- 错误状态 -->
<view class="error-state" wx:if="{{!loading && loadError}}">
  <text class="error-state-icon">⚠️</text>
  <text class="error-state-text">{{t('searchFailed')}}</text>
  <button class="retry-btn" bindtap="retrySearch">{{t('retrySearch')}}</button>
</view>

<!-- 搜索结果列表 -->
<view class="result-container" wx:if="{{!loading && !loadError && searched}}">
  <!-- 无结果 -->
  <view class="empty-state" wx:if="{{results.length === 0}}">
    <text class="empty-state-icon">🔍</text>
    <text class="empty-state-text">{{t('noResults')}}</text>
  </view>
  
  <!-- 车手结果 -->
  <view wx:if="{{searchType === 'riders' && results.length > 0}}">
    <view
      class="result-card"
      wx:for="{{results}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goToDetail"
    >
      <view class="tag tag-blue">{{item.nationality}}</view>
      <view class="result-info">
        <text class="result-name">{{item.rider_name_zh || item.rider_name}}</text>
        <text class="result-sub" wx:if="{{item.rider_name_zh}}">{{item.rider_name}}</text>
      </view>
      <text class="arrow">&gt;</text>
    </view>
  </view>
  
  <!-- 车队结果 -->
  <view wx:if="{{searchType === 'teams' && results.length > 0}}">
    <view
      class="result-card"
      wx:for="{{results}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goToDetail"
    >
      <view class="tag tag-blue">{{item.uci_code}}</view>
      <view class="result-info">
        <text class="result-name">{{item.team_name_zh || item.team_name}}</text>
        <text class="result-sub" wx:if="{{item.team_name_zh}}">{{item.team_name}}</text>
      </view>
      <text class="arrow">&gt;</text>
    </view>
  </view>
</view>
