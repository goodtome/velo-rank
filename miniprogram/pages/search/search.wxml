<view class="search-bar">
  <view class="search-input-wrap">
    <text class="search-icon">🔎</text>
    <input
      class="search-input"
      type="text"
      placeholder="搜索车手、车队、赛事"
      value="{{keyword}}"
      bindinput="onInput"
      confirm-type="search"
    />
    <view wx:if="{{keyword}}" class="clear-btn" bindtap="clearInput">
      <text>×</text>
    </view>
  </view>
</view>

<view class="tab-bar">
  <view class="tab-item {{searchType === 'riders' ? 'tab-active' : ''}}" data-type="riders" bindtap="switchTab">
    <text>车手</text>
  </view>
  <view class="tab-item {{searchType === 'teams' ? 'tab-active' : ''}}" data-type="teams" bindtap="switchTab">
    <text>车队</text>
  </view>
  <view class="tab-item {{searchType === 'races' ? 'tab-active' : ''}}" data-type="races" bindtap="switchTab">
    <text>赛事</text>
  </view>
</view>

<view class="container" wx:if="{{!searched && !loading && !keyword && searchHistory.length > 0}}">
  <view class="history-header">
    <text class="history-title">搜索历史</text>
    <text class="history-clear" bindtap="clearHistory">清除</text>
  </view>
  <view class="history-list">
    <view class="history-tag" wx:for="{{searchHistory}}" wx:key="*this" data-keyword="{{item}}" bindtap="tapHistory">
      <text>{{item}}</text>
    </view>
  </view>
</view>

<view class="initial-state" wx:if="{{!searched && !loading && !keyword && searchHistory.length === 0}}">
  <text class="initial-icon">🔎</text>
  <text class="initial-text">搜索车手、车队或赛事</text>
</view>

<view class="loading-container" wx:if="{{loading}}">
  <view class="loading-spinner"></view>
  <text class="loading-text" wx:if="{{keyword}}">搜索中...</text>
  <text class="loading-text" wx:else>加载中...</text>
</view>

<view class="error-state" wx:if="{{!loading && loadError}}">
  <text class="error-state-icon">⚠️</text>
  <text class="error-state-text">搜索失败，请检查网络后重试</text>
  <button class="retry-btn" bindtap="retrySearch">重试</button>
</view>

<view class="result-container" wx:if="{{!loading && !loadError && searched}}">
  <view class="empty-state" wx:if="{{results.length === 0}}">
    <text class="empty-state-icon">🔎</text>
    <text class="empty-state-text" wx:if="{{keyword}}">未找到与 {{keyword}} 相关的{{searchTypeLabel}}</text>
    <text class="empty-state-text" wx:else>暂无{{searchTypeLabel}}数据</text>
  </view>

  <view wx:if="{{results.length > 0}}" class="result-count-bar">
    <text class="result-count-text" wx:if="{{keyword}}">找到 {{totalCount}} 条{{searchTypeLabel}}，已显示 {{results.length}} 条</text>
    <text class="result-count-text" wx:else>共 {{totalCount}} 条{{searchTypeLabel}}，已显示 {{results.length}} 条</text>
  </view>

  <view wx:if="{{searchType === 'riders' && results.length > 0}}">
    <view class="result-card" wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="goToDetail">
      <view class="tag tag-blue">{{item.nationalityZh || item.nationality || '车手'}}</view>
      <view class="result-info">
        <text class="result-name">{{item.displayName}}</text>
        <text class="result-sub" wx:if="{{item.displaySub}}">{{item.displaySub}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:if="{{searchType === 'teams' && results.length > 0}}">
    <view class="result-card" wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="goToDetail">
      <view class="tag tag-blue">{{item.uci_code || '车队'}}</view>
      <view class="result-info">
        <text class="result-name">{{item.displayName}}</text>
        <text class="result-sub" wx:if="{{item.displaySub}}">{{item.displaySub}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:if="{{searchType === 'races' && results.length > 0}}">
    <view class="result-card race-result-card" wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="goToDetail">
      <view class="tag tag-blue">{{item.season}} 赛季</view>
      <view class="result-info">
        <text class="result-name">{{item.displayName}}</text>
        <text class="result-sub" wx:if="{{item.displaySub}}">{{item.displaySub}}</text>
        <view class="race-tag-row">
          <text wx:if="{{item.genderLabel}}" class="tag tag-green">{{item.genderLabel}}</text>
          <text wx:if="{{item.typeLabel}}" class="tag tag-orange">{{item.typeLabel}}</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="load-more-wrap" wx:if="{{results.length > 0 && hasMore}}">
    <button class="load-more-btn" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">
      {{loadingMore ? '加载中...' : '加载更多'}}
    </button>
  </view>
</view>
