<!--pages/stage-results/stage-results.wxml-->
<view class="container">

  <!-- 骨架屏加载状态 -->
  <view wx:if="{{loading}}" class="skeleton-container">
    <view class="skeleton-card">
      <view class="skeleton-item skeleton-title"></view>
      <view class="skeleton-item skeleton-text"></view>
    </view>
    <view class="skeleton-card">
      <view wx:for="{{[1,2,3,4,5,6,7,8]}}" wx:key="*this" style="display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f0f0f0;">
        <view class="skeleton-item" style="width:60rpx;height:28rpx;margin-right:16rpx;"></view>
        <view style="flex:1;">
          <view class="skeleton-item skeleton-text"></view>
        </view>
        <view class="skeleton-item" style="width:120rpx;height:28rpx;"></view>
      </view>
    </view>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{loadError}}" class="error-state">
    <text class="error-state-icon">😵</text>
    <text class="error-state-text">{{errorMessage || '加载失败，请检查网络'}}</text>
    <button class="retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:else>
    <!-- 顶部导航切换 -->
    <scroll-view scroll-x class="tabs-nav card" enable-flex>
      <view 
        wx:for="{{tabs}}" 
        wx:key="id" 
        class="tab-item {{type === item.id ? 'tab-active' : ''}}" 
        bindtap="switchTab" 
        data-id="{{item.id}}"
      >
        <text>{{item.name}}</text>
        <view class="tab-line" wx:if="{{type === item.id}}"></view>
      </view>
    </scroll-view>

    <!-- 赛段信息头 -->
    <view wx:if="{{type === 'stage'}}" class="stage-header card">
      <view class="stage-title-row">
        <view class="num-badge">{{stage.stage_number}}</view>
        <view class="stage-title-text">第 {{stage.stage_number}} 赛段</view>
        <text class="stage-type-tag tag-{{stage.stage_type}}" wx:if="{{stage._stage_type_zh}}">{{stage._stage_type_zh}}</text>
      </view>
      <!-- 日期 + 距离 同一行 -->
      <view class="stage-meta-row" wx:if="{{stage._date_formatted || stage._distance_formatted}}">
        <text class="meta-item" wx:if="{{stage._date_formatted}}">{{stage._date_formatted}}</text>
        <text class="meta-dot" wx:if="{{stage._date_formatted && stage._distance_formatted}}"> 丨 </text>
        <text class="meta-item" wx:if="{{stage._distance_formatted}}">{{stage._distance_formatted}}</text>
      </view>
      <!-- 路线：中英文合并一行 -->
      <view class="stage-route-combined" wx:if="{{stage._route_combined}}">{{stage._route_combined}}</view>
    </view>

    <!-- 总成绩榜标题 -->
    <view wx:if="{{type === 'gc'}}" class="gc-header card {{gcHeaderClass}}">
      <view class="gc-icon">🏆</view>
      <view>
        <view class="gc-title">总成绩榜 (GC)</view>
        <view class="gc-sub">赛事总排名</view>
      </view>
    </view>

    <!-- 领骑衫 -->
    <view wx:if="{{type === 'gc' && jerseys.length > 0}}" class="jerseys-section card">
      <view class="section-label">领骑衫</view>
      <view class="jerseys-grid">
        <view wx:for="{{jerseys}}" wx:key="jersey_type" class="jersey-card">
          <view class="jersey-circle-md jersey-{{item.jersey_type}}"></view>
          <view class="jersey-detail">
            <text class="jersey-type-name">{{item._jersey_type_zh}}</text>
            <text class="jersey-rider">{{item.rider_name_zh || item.rider_name}}</text>
            <text class="jersey-team">{{item.team_name_zh || item.team_name}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{type === 'gc' && gcTrend.points.length > 0}}" class="gc-trend-card card">
      <view class="gc-trend-header">
        <view>
          <view class="section-label">GC 时间差走势图</view>
          <view class="gc-trend-sub">相对第一名的累计时间差变化</view>
        </view>
        <view class="gc-trend-badge">{{gcTrend.maxGapLabel}}</view>
      </view>

      <scroll-view scroll-x="true" class="gc-trend-scroll" show-scrollbar="false">
        <view class="gc-trend-chart" style="width: {{gcTrend.chartWidth}}rpx; height: {{gcTrend.chartHeight}}rpx;">
          <view
            wx:for="{{gcTrend.segments}}"
            wx:key="index"
            class="gc-trend-segment"
            style="{{item.style}}"
          ></view>
          <view
            wx:for="{{gcTrend.points}}"
            wx:key="rank"
            class="gc-trend-point"
            style="{{item.pointStyle}}"
          >
            <view class="gc-trend-gap">{{item.gapLabel}}</view>
            <view class="gc-trend-dot {{item.isLeader ? 'gc-trend-dot-leader' : ''}} {{item.isMissing ? 'gc-trend-dot-missing' : ''}}"></view>
            <view class="gc-trend-rank">{{item.rankLabel}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 成绩列表 -->
    <view class="results-section card">
      <view class="section-label">
        <text wx:if="{{type === 'stage' && stageResultKind === 'team'}}">车队赛段排名</text>
        <text wx:elif="{{type === 'stage'}}">赛段排名</text>
        <text wx:elif="{{type === 'gc'}}">总成绩排名 (GC)</text>
        <text wx:elif="{{type === 'team'}}">车队成绩排名</text>
        <text wx:elif="{{type === 'points'}}">冲刺积分排名</text>
        <text wx:elif="{{type === 'mountains'}}">爬坡积分排名</text>
        <text wx:elif="{{type === 'youth'}}">青年车手排名</text>
      </view>

      <!-- 表头 -->
      <view class="result-header">
        <text class="rh-rank">排名</text>
        <text class="rh-rider">{{(type === 'team' || stageResultKind === 'team') ? '车队' : '车手'}}</text>
        <text class="rh-team">{{(type === 'team' || stageResultKind === 'team') ? '代号' : '车队'}}</text>
        <text class="rh-time">{{(type === 'points' || type === 'mountains') ? '积分' : ((type === 'team' || stageResultKind === 'team' || type === 'gc' || type === 'youth') ? '总时间' : '差距')}}</text>
      </view>

      <!-- 空成绩提示 -->
      <view wx:if="{{results.length === 0}}" class="empty-state">
        <text class="empty-state-icon">🏁</text>
        <text class="empty-state-text">暂无成绩数据</text>
      </view>

      <!-- 列表 -->
      <view 
        wx:for="{{results}}" 
        wx:key="rank"
        class="result-row {{index < 3 ? 'result-top3' : ''}} {{index === 0 ? 'result-gold' : index === 1 ? 'result-silver' : index === 2 ? 'result-bronze' : ''}}"
        hover-class="result-row-hover"
        bindtap="{{(type === 'team' || stageResultKind === 'team') ? '' : 'goToRider'}}"
        data-id="{{item.rider_id}}"
      >
        <view class="rr-rank {{index < 3 ? 'rr-rank-medal' : ''}}">
          <text wx:if="{{index === 0}}">🥇</text>
          <text wx:elif="{{index === 1}}">🥈</text>
          <text wx:elif="{{index === 2}}">🥉</text>
          <text wx:else>{{item.rank}}</text>
        </view>

        <!-- 车手/车队显示逻辑 -->
        <block wx:if="{{type === 'team' || stageResultKind === 'team'}}">
          <view class="rr-rider">
            <text class="rider-name">{{item.team_name_zh || item.team_name}}</text>
          </view>
          <text class="rr-team">{{item.uci_code}}</text>
        </block>
        <block wx:else>
          <view class="rr-rider">
            <text class="rider-name">{{item.rider_name_zh || item.rider_name}}</text>
            <text class="rider-nat">{{item.nationality}}</text>
          </view>
          <text class="rr-team">{{item.team_name_zh || item.team_name}}</text>
        </block>

        <view class="rr-time">
          <!-- 积分显示 -->
          <text wx:if="{{type === 'points' || type === 'mountains'}}" class="time-main">{{item.points}} Pts</text>
          <!-- 时间显示 -->
          <text wx:elif="{{type === 'team' || stageResultKind === 'team' || type === 'gc' || type === 'youth'}}" class="time-main">{{item.total_time || item.time}}</text>
          <!-- 赛段差距显示 -->
          <text wx:else class="time-main">{{item.time_gap || '-'}}</text>
          <text wx:if="{{(type === 'gc' || type === 'youth' || type === 'team' || stageResultKind === 'team') && item.time_gap}}" class="time-gap">({{item.time_gap}})</text>
        </view>
      </view>

      <!-- 加载更多 -->
      <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">
        <text wx:if="{{loadingMore}}">加载中...</text>
        <text wx:else>加载更多</text>
      </view>
      <view wx:elif="{{results.length > 0}}" class="load-more load-more-done">
        <text class="load-complete">已加载全部 {{results.length}} 条数据</text>
      </view>
    </view>
  </view>
</view>
