/* pages/stage-results/stage-results.wxss */

/* 赛段信息头 */
.stage-header {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.stage-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.stage-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  margin-left: 16rpx;
}

.stage-route {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
}

.stage-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.stage-type {
  background: #e3f2fd;
  color: #2196F3;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

/* GC头部 */
.gc-header {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.gc-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.gc-sub {
  font-size: 22rpx;
  opacity: 0.85;
}

/* 领骑衫 */
.jerseys-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.jersey-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.jersey-row:last-child {
  border-bottom: none;
}

.jersey-dot {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}


.jersey-info {
  display: flex;
  flex-direction: column;
}

.jersey-type-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.jersey-rider {
  font-size: 22rpx;
  color: #666;
}

.jersey-team {
  font-size: 20rpx;
  color: #999;
}

/* 成绩列表 */
.results-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

/* 表头 */
.result-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 4rpx;
  font-size: 22rpx;
  color: #999;
  font-weight: 600;
}

.rh-rank { width: 80rpx; }
.rh-rider { flex: 1; padding: 0 12rpx; }
.rh-team { width: 100rpx; text-align: center; }
.rh-time { width: 160rpx; text-align: right; }

/* 列表行 */
.result-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
  transition: background 0.15s;
}

.result-row-hover {
  background: #f8f9fa;
}

.result-top3 {
  background: #f0f7ff;
  border-radius: 12rpx;
  padding: 20rpx 12rpx;
  margin: 4rpx 0;
  border-bottom: none;
}

.rr-rank {
  width: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
}

.rr-rank-top3 {
  color: #2196F3;
  font-weight: 700;
}

.rr-rider {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 12rpx;
}

.rider-name {
  font-size: 26rpx;
  color: #222;
  font-weight: 500;
}

.rider-nat {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

.rr-team {
  width: 100rpx;
  font-size: 22rpx;
  color: #888;
  text-align: center;
}

.rr-time {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-size: 26rpx;
  color: #222;
}

.time-gap {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

/* loading */
.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
