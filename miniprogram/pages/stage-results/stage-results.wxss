/* pages/stage-results/stage-results.wxss */

/* ====== 顶部导航切换 ====== */
.tabs-nav {
  display: flex;
  white-space: nowrap;
  background: #fff;
  padding: 10rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 30rpx;
  position: relative;
  transition: all 0.3s;
}

.tab-item text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.tab-active text {
  color: #2196F3;
  font-weight: 700;
  font-size: 30rpx;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  background: #2196F3;
  border-radius: 4rpx;
}

/* ====== 赛段信息头 ====== */
.stage-header {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.stage-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 12rpx;
}

.stage-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.stage-type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-Flat { background: #e8f5e9; color: #388E3C; }
.tag-Hills { background: #fff3e0; color: #F57C00; }
.tag-Mountain { background: #fce4ec; color: #c62828; }
.tag-TTT { background: #e3f2fd; color: #1565C0; }
.tag-ITT { background: #e3f2fd; color: #1565C0; }

.stage-date-row {
  margin-bottom: 8rpx;
}

.stage-date {
  font-size: 24rpx;
  color: #888;
}

/* 中英文合并路线 */
.stage-route-combined {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 4rpx;
  line-height: 1.4;
}

.stage-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

/* ====== GC头部 ====== */
.gc-header {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.gc-icon {
  font-size: 48rpx;
}

.gc-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.gc-sub {
  font-size: 22rpx;
  opacity: 0.85;
}

/* ====== 领骑衫 ====== */
.jerseys-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.jerseys-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.jersey-card {
  display: flex;
  align-items: center;
  flex: 0 0 calc(50% - 6rpx);
  background: #f8f9fa;
  border-radius: 14rpx;
  padding: 14rpx;
  box-sizing: border-box;
}

.jersey-circle-md {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.jersey-pink,
.jersey-PINK { background: linear-gradient(135deg, #ff69b4, #ff1493); }
.jersey-purple,
.jersey-PURPLE { background: linear-gradient(135deg, #9b59b6, #8e44ad); }
.jersey-blue,
.jersey-BLUE { background: linear-gradient(135deg, #3498db, #2980b9); }
.jersey-white,
.jersey-WHITE { background: linear-gradient(135deg, #ecf0f1, #bdc3c7); }
.jersey-BLUE_SPRINT { background: linear-gradient(135deg, #3498db, #2980b9); }
.jersey-WHITE_YOUTH { background: linear-gradient(135deg, #ecf0f1, #bdc3c7); }

.jersey-detail {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex: 1;
}

.jersey-type-name {
  font-size: 20rpx;
  color: #999;
}

.jersey-rider {
  font-size: 24rpx;
  font-weight: 600;
  color: #222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.jersey-team {
  font-size: 18rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ====== 成绩列表 ====== */
.results-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

/* 表头 */
.result-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 4rpx;
  font-size: 22rpx;
  color: #999;
  font-weight: 600;
}

.rh-rank { width: 80rpx; }
.rh-rider { flex: 1; padding: 0 12rpx; }
.rh-team { width: 120rpx; text-align: center; }
.rh-time { width: 160rpx; text-align: right; }

/* 列表行 */
.result-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
  transition: background 0.15s;
}

.result-row-hover {
  background: #f8f9fa;
}

/* 前三名高亮 */
.result-top3 {
  border-radius: 14rpx;
  padding: 20rpx 10rpx;
  margin: 6rpx 0;
  border-bottom: none;
}

.result-gold {
  background: linear-gradient(135deg, #fff8e1, #fff3e0);
  border-left: 4rpx solid #FFD700;
}

.result-silver {
  background: linear-gradient(135deg, #f5f5f5, #eeeeee);
  border-left: 4rpx solid #C0C0C0;
}

.result-bronze {
  background: linear-gradient(135deg, #fbe9e7, #ffccbc);
  border-left: 4rpx solid #CD7F32;
}

.rr-rank {
  width: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
  text-align: center;
}

.rr-rank-medal {
  font-size: 32rpx;
}

.rr-rider {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 12rpx;
}

.rider-name {
  font-size: 26rpx;
  color: #222;
  font-weight: 500;
}

.rider-nat {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

.rr-team {
  width: 120rpx;
  font-size: 20rpx;
  color: #888;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rr-time {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.time-main {
  font-size: 26rpx;
  color: #222;
  font-weight: 500;
}

.time-gap {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx;
  color: #2196F3;
  font-size: 26rpx;
}
