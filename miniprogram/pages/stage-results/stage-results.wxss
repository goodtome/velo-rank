/* pages/stage-results/stage-results.wxss */

/* ====== 顶部导航切换 ====== */
.tabs-nav {
  display: flex;
  white-space: nowrap;
  background: #fff;
  padding: 10rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 30rpx;
  position: relative;
  transition: all 0.3s;
}

.tab-item text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.tab-active text {
  color: #2196F3;
  font-weight: 700;
  font-size: 30rpx;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  background: #2196F3;
  border-radius: 4rpx;
}

/* ====== 赛段信息头 ====== */
.stage-header {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.stage-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 12rpx;
}

.stage-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.stage-type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-Flat { background: #e8f5e9; color: #388E3C; }
.tag-Hills { background: #fff3e0; color: #F57C00; }
.tag-Mountain { background: #fce4ec; color: #c62828; }
.tag-TTT { background: #e3f2fd; color: #1565C0; }
.tag-ITT { background: #e3f2fd; color: #1565C0; }

.stage-date-row {
  margin-bottom: 8rpx;
}

.stage-date {
  font-size: 24rpx;
  color: #888;
}

/* 中英文合并路线 */
.stage-route-combined {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 4rpx;
  line-height: 1.4;
}

.stage-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

/* ====== GC头部 ====== */
.gc-header {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 环法 - 黄衫配色 */
.gc-header.gc-tdf {
  background: linear-gradient(135deg, #FFD700, #FFC107);
  color: #333;
}

/* 环意 - 粉衫配色 */
.gc-header.gc-giro {
  background: linear-gradient(135deg, #ff69b4, #ff1493);
}

/* 环西 - 红衫配色 */
.gc-header.gc-vuelta {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
}

.gc-icon {
  font-size: 48rpx;
}

.gc-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.gc-sub {
  font-size: 22rpx;
  opacity: 0.85;
}

/* ====== GC 时间差走势图 ====== */
.gc-trend-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.gc-trend-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.gc-trend-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7f8c8d;
}

.gc-trend-badge {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(33, 150, 243, 0.12);
  color: #1565c0;
  font-size: 22rpx;
  font-weight: 600;
}

.gc-trend-scroll {
  width: 100%;
  overflow: hidden;
}

.gc-trend-chart {
  position: relative;
  min-height: 240rpx;
  padding: 12rpx 8rpx 18rpx;
}

.gc-trend-segment {
  position: absolute;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(33,150,243,0.25), rgba(21,101,192,0.75));
  transform-origin: 0 50%;
}

.gc-trend-point {
  position: absolute;
  width: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translate(-50%, -50%);
}

.gc-trend-gap {
  font-size: 18rpx;
  color: #1565c0;
  font-weight: 600;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.gc-trend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #1565c0;
  box-shadow: 0 0 0 6rpx rgba(33, 150, 243, 0.10);
}

.gc-trend-dot-leader {
  background: #ff9800;
  box-shadow: 0 0 0 6rpx rgba(255, 152, 0, 0.16);
}

.gc-trend-dot-missing {
  background: #90a4ae;
  box-shadow: 0 0 0 6rpx rgba(144, 164, 174, 0.14);
}

.gc-trend-rank {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #34495e;
}

/* ====== 领骑衫 ====== */
.jerseys-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.jerseys-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.jersey-card {
  display: flex;
  align-items: center;
  flex: 0 0 calc(50% - 6rpx);
  background: #f8f9fa;
  border-radius: 14rpx;
  padding: 14rpx;
  box-sizing: border-box;
}

.jersey-circle-md {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.jersey-detail {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex: 1;
}

.jersey-type-name {
  font-size: 20rpx;
  color: #999;
}

.jersey-rider {
  font-size: 24rpx;
  font-weight: 600;
  color: #222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.jersey-team {
  font-size: 18rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ====== 成绩列表 ====== */
.results-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

/* 表头 */
.result-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 4rpx;
  font-size: 22rpx;
  color: #999;
  font-weight: 600;
}

.rh-rank { width: 80rpx; }
.rh-rider { flex: 1; padding: 0 12rpx; }
.rh-team { width: 120rpx; text-align: center; }
.rh-time { width: 160rpx; text-align: right; }

/* 列表行 */
.result-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
  transition: background 0.15s;
}

.result-row-hover {
  background: #f8f9fa;
}

/* 前三名高亮 */
.result-top3 {
  border-radius: 14rpx;
  padding: 20rpx 10rpx;
  margin: 6rpx 0;
  border-bottom: none;
}

.result-gold {
  background: linear-gradient(135deg, #fff8e1, #fff3e0);
  border-left: 4rpx solid #FFD700;
}

.result-silver {
  background: linear-gradient(135deg, #f5f5f5, #eeeeee);
  border-left: 4rpx solid #C0C0C0;
}

.result-bronze {
  background: linear-gradient(135deg, #fbe9e7, #ffccbc);
  border-left: 4rpx solid #CD7F32;
}

.rr-rank {
  width: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
  text-align: center;
}

.rr-rank-medal {
  font-size: 32rpx;
}

.rr-rider {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 12rpx;
}

.rider-name {
  font-size: 26rpx;
  color: #222;
  font-weight: 500;
}

.rider-nat {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

.rr-team {
  width: 120rpx;
  font-size: 20rpx;
  color: #888;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rr-time {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.time-main {
  font-size: 26rpx;
  color: #222;
  font-weight: 500;
}

.time-gap {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

/* 加载更多 */
.load-more {
  width: 520rpx;
  height: 96rpx;
  margin: 32rpx auto;
  padding: 0;
  border-radius: 48rpx;
  background: #2196F3;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  text-align: center;
  box-sizing: border-box;
}

.load-complete {
  color: #999;
  font-size: 26rpx;
  font-weight: 400;
}

.load-more-done {
  width: auto;
  height: auto;
  margin: 24rpx auto;
  background: transparent;
}
