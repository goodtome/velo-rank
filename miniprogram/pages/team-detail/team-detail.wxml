<!--pages/team-detail/team-detail.wxml-->
<view class="container">

  <!-- 骨架屏加载状态 -->
  <view wx:if="{{loading}}" class="skeleton-container">
    <view class="skeleton-header">
      <view class="skeleton-avatar skeleton-item"></view>
      <view class="skeleton-header-info">
        <view class="skeleton-item skeleton-title"></view>
        <view class="skeleton-item skeleton-text"></view>
        <view class="skeleton-item skeleton-text-short"></view>
      </view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-item skeleton-title"></view>
      <view wx:for="{{[1,2,3,4]}}" wx:key="*this" style="display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #f0f0f0;">
        <view class="skeleton-item" style="width:120rpx;height:24rpx;"></view>
        <view class="skeleton-item" style="width:200rpx;height:24rpx;"></view>
      </view>
    </view>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{loadError}}" class="error-state">
    <text class="error-state-icon">😵</text>
    <text class="error-state-text">{{errorMessage || '加载失败，请检查网络'}}</text>
    <button class="retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <!-- 数据为空 -->
  <view wx:elif="{{!team}}" class="empty-state">
    <text class="empty-state-icon">🚲</text>
    <text class="empty-state-text">未找到车队信息</text>
  </view>

  <!-- 正常内容 -->
  <view wx:else>

    <!-- 头部卡片 -->
    <view class="header-card">
      <view class="header-main">
        <view class="logo-wrap">
          <image wx:if="{{team.logo_url}}" class="logo" src="{{team.logo_url}}" mode="aspectFill" lazy-load></image>
          <view wx:else class="logo logo-placeholder">🚲</view>
        </view>
        <view class="header-info">
          <text class="team-name-zh">{{teamName.zh || teamName.en}}</text>
          <text wx:if="{{teamName.zh && teamName.en}}" class="team-name-en">{{teamName.en}}</text>
          <view wx:if="{{team.uci_code}}" class="uci-code-tag">{{team.uci_code}}</view>
        </view>
      </view>
    </view>

    <!-- 统计卡片（新增） -->
    <view wx:if="{{stats}}" class="card-base stats-card">
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-value stats-highlight">{{stats.total_riders || 0}}</text>
          <text class="stat-label">车手</text>
        </view>
        <view class="stat-item">
          <text class="stat-value stats-gold">{{stats.stage_wins || 0}}</text>
          <text class="stat-label">🏆 赛段冠军</text>
        </view>
        <view class="stat-item">
          <text class="stat-value stats-silver">{{stats.podiums || 0}}</text>
          <text class="stat-label">🥈🥉 领奖台</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{stats.top10 || 0}}</text>
          <text class="stat-label">前10名</text>
        </view>
      </view>
      <!-- 次要统计 -->
      <view wx:if="{{stats.total_entries || stats.jerseys_held}}" class="stats-secondary">
        <view wx:if="{{stats.total_entries}}" class="info-item">
          <text class="info-label">参赛次数</text>
          <text class="info-value">{{stats.total_entries}}</text>
        </view>
        <view wx:if="{{stats.jerseys_held}}" class="info-item">
          <text class="info-label">领骑衫</text>
          <text class="info-value stats-gold">{{stats.jerseys_held}} 次</text>
        </view>
      </view>
    </view>

    <!-- 参赛赛事（新增） -->
    <view wx:if="{{teamInsights.hasData}}" class="card-base team-insights-card">
      <view class="section-title">团队表现</view>
      <view class="team-insights-grid">
        <view wx:for="{{teamInsights.profileItems}}" wx:key="key" class="team-insights-item team-insights-{{item.tone}}">
          <text class="team-insights-value">{{item.value}}</text>
          <text class="team-insights-label">{{item.label}}</text>
        </view>
      </view>

      <view wx:if="{{teamInsights.topRiders.length > 0}}" class="team-insights-section">
        <view class="team-insights-subtitle">核心车手</view>
        <view wx:for="{{teamInsights.topRiders}}" wx:key="id" class="team-leader-row" bindtap="goToRider" data-id="{{item.id}}" hover-class="team-leader-row-hover">
          <view class="team-leader-main">
            <text class="team-leader-name">{{item.name}}</text>
            <text class="team-leader-meta">{{item.nationality}} · {{item.wins}} 胜 · {{item.podiums}} 次领奖台</text>
          </view>
          <text class="team-leader-rank">最佳 {{item.bestRank}}</text>
        </view>
      </view>

      <view wx:if="{{teamInsights.seasonSummaries.length > 0}}" class="team-insights-section">
        <view class="team-insights-subtitle">赛季汇总</view>
        <view wx:for="{{teamInsights.seasonSummaries}}" wx:key="season" class="team-season-row">
          <text class="team-season-year">{{item.season}}</text>
          <text class="team-season-meta">{{item.starts}} 次出赛</text>
          <text class="team-season-meta team-season-win">{{item.wins}} 胜</text>
          <text class="team-season-meta">{{item.podiums}} 次领奖台</text>
        </view>
      </view>

      <view wx:if="{{teamInsights.highlights.length > 0}}" class="team-insights-section">
        <view class="team-insights-subtitle">近期高光</view>
        <view wx:for="{{teamInsights.highlights}}" wx:key="id" class="team-highlight-row">
          <view class="team-highlight-main">
            <text class="team-highlight-race">{{item.raceName}} · {{item.stageLabel}}</text>
            <text class="team-highlight-rider">{{item.riderName}}</text>
          </view>
          <text class="team-highlight-rank {{item.isWin ? 'team-highlight-win' : ''}}">{{item.rankLabel}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{stats && stats.recent_races && stats.recent_races.length > 0}}" class="card-base races-card">
      <view class="section-title">参赛赛事</view>
      <view wx:for="{{stats.recent_races}}" wx:key="id" class="race-item">
        <text class="race-name">{{item.race_name_zh || item.race_name}}</text>
        <view class="race-meta">
          <text class="tag tag-blue">{{item.season}}</text>
          <text wx:if="{{item.category}}" class="tag tag-orange">{{item.category}}</text>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="card-base info-card">
      <view class="section-title">车队信息</view>
      <view wx:if="{{team.uci_code}}" class="info-item">
        <text class="info-label">UCI代码</text>
        <text class="info-value">{{team.uci_code}}</text>
      </view>
      <view wx:if="{{teamName.en}}" class="info-item">
        <text class="info-label">英文名</text>
        <text class="info-value">{{teamName.en}}</text>
      </view>
      <view wx:if="{{team.country}}" class="info-item">
        <text class="info-label">注册国家</text>
        <text class="info-value">{{team.country}}</text>
      </view>
      <view wx:if="{{team.category}}" class="info-item">
        <text class="info-label">车队级别</text>
        <text class="info-value">{{team.category}}</text>
      </view>
      <view wx:if="{{team.bike_brand}}" class="info-item">
        <text class="info-label">自行车品牌</text>
        <text class="info-value">{{team.bike_brand}}</text>
      </view>
    </view>

    <!-- 车手阵容 -->
    <view wx:if="{{riders && riders.length > 0}}" class="card-base riders-card">
      <view class="section-title">车手阵容</view>
      <view wx:for="{{riders}}" wx:key="id" class="rider-item" bindtap="goToRider" data-id="{{item.id}}" hover-class="rider-item-hover">
        <view class="rider-info">
          <text wx:if="{{item.nationality}}" class="rider-nationality">{{item.nationality}}</text>
          <text class="rider-name-zh">{{item.displayName}}</text>
          <text wx:if="{{item.displaySub}}" class="rider-name-en">{{item.displaySub}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

  </view>
</view>
