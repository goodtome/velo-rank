/* pages/team-detail/team-detail.wxss */

/* 骨架屏 */
.skeleton-container {
  padding: 0;
}

.skeleton-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4CAF50, #388E3C);
  border-radius: 0 0 32rpx 32rpx;
  padding: 48rpx 32rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.skeleton-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.skeleton-header-info {
  flex: 1;
}

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #4CAF50, #388E3C);
  border-radius: 0 0 32rpx 32rpx;
  padding: 48rpx 32rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.header-main {
  display: flex;
  align-items: center;
}

.logo-wrap {
  margin-right: 32rpx;
  flex-shrink: 0;
}

.logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.logo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: rgba(255, 255, 255, 0.2);
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.team-name-zh {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}

.team-name-en {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
  line-height: 1.3;
}

.uci-code-tag {
  display: inline-block;
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 12rpx;
}

/* 基本信息 */
.info-card {
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
}

/* 车手阵容 */
.riders-card {
  margin-bottom: 24rpx;
}

.rider-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.rider-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.rider-item-hover {
  background: #f8f9fa;
}

.rider-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.rider-nationality {
  font-size: 22rpx;
  color: #4CAF50;
  background: rgba(76, 175, 80, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  align-self: flex-start;
  margin-bottom: 6rpx;
}

.rider-name-zh {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.rider-name-en {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
