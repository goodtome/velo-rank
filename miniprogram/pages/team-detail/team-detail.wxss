/* pages/team-detail/team-detail.wxss */

/* 骨架屏 */
.skeleton-container {
  padding: 0;
}

.skeleton-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4CAF50, #388E3C);
  border-radius: 0 0 32rpx 32rpx;
  padding: 48rpx 32rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.skeleton-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.skeleton-header-info {
  flex: 1;
}

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #4CAF50, #388E3C);
  border-radius: 0 0 32rpx 32rpx;
  padding: 48rpx 32rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.header-main {
  display: flex;
  align-items: center;
}

.logo-wrap {
  margin-right: 32rpx;
  flex-shrink: 0;
}

.logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.logo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: rgba(255, 255, 255, 0.2);
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.team-name-zh {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}

.team-name-en {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
  line-height: 1.3;
}

.uci-code-tag {
  display: inline-block;
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 12rpx;
}

/* 基本信息 */
.info-card {
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
}

/* 车手阵容 */
.riders-card {
  margin-bottom: 24rpx;
}

.rider-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.rider-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.rider-item-hover {
  background: #f8f9fa;
}

.rider-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.rider-nationality {
  font-size: 22rpx;
  color: #4CAF50;
  background: rgba(76, 175, 80, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  align-self: flex-start;
  margin-bottom: 6rpx;
}

.rider-name-zh {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.rider-name-en {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 统计卡片 */
.stats-card {
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.stats-highlight {
  color: #1565c0;
}

.stats-gold {
  color: #f57f17;
}

.stats-silver {
  color: #6d4c41;
}

.team-insights-card {
  margin-bottom: 24rpx;
}

.team-insights-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.team-insights-item {
  display: flex;
  flex-direction: column;
  min-height: 86rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
}

.team-insights-value {
  color: #1565c0;
  font-size: 34rpx;
  font-weight: 800;
}

.team-insights-label {
  margin-top: 6rpx;
  color: #7f8c8d;
  font-size: 20rpx;
}

.team-insights-gold .team-insights-value { color: #f57f17; }
.team-insights-green .team-insights-value { color: #2e7d32; }
.team-insights-purple .team-insights-value { color: #7b1fa2; }

.team-insights-section {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f3;
}

.team-insights-subtitle {
  margin-bottom: 10rpx;
  color: #34495e;
  font-size: 24rpx;
  font-weight: 700;
}

.team-leader-row,
.team-season-row,
.team-highlight-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
}

.team-leader-row:last-child,
.team-season-row:last-child,
.team-highlight-row:last-child {
  border-bottom: none;
}

.team-leader-row-hover { background: #f8fbff; }

.team-leader-main,
.team-highlight-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.team-leader-name,
.team-highlight-race {
  overflow: hidden;
  color: #34495e;
  font-size: 24rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-leader-meta,
.team-highlight-rider,
.team-season-meta {
  margin-top: 4rpx;
  color: #7f8c8d;
  font-size: 20rpx;
}

.team-leader-rank,
.team-highlight-rank {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #e3f2fd;
  color: #1565c0;
  font-size: 20rpx;
  font-weight: 800;
}

.team-highlight-win {
  background: #fff3cd;
  color: #a75b00;
}

.team-season-year {
  min-width: 72rpx;
  color: #1565c0;
  font-size: 26rpx;
  font-weight: 800;
}

.team-season-win {
  color: #f57f17;
  font-weight: 700;
}

/* 次要统计 */
.stats-secondary {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stats-secondary .info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.stats-secondary .info-item:last-child {
  border-bottom: none;
}

.stats-secondary .info-label {
  font-size: 26rpx;
  color: #999;
}

.stats-secondary .info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 参赛赛事 */
.races-card {
  margin-bottom: 24rpx;
}

.race-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.race-item:last-child {
  border-bottom: none;
}

.race-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.race-meta {
  display: flex;
  gap: 8rpx;
}

/* 标签 */
.tag-blue {
  background: #e3f2fd;
  color: #1565c0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.tag-orange {
  background: #fff3e0;
  color: #e65100;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}
