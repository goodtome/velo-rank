{
  "name": "zhengyi-lingqi",
  "version": "1.0.0",
  "description": "正一领骑 - 自行车比赛成绩查询小程序后端 API",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon server/app.js",
    "init-db": "node server/scripts/init-db.js",
    "seed": "node server/scripts/seed-test-data.js",
    "sync-pcs": "node server/scripts/sync-pcs.js",
    "backup": "node server/scripts/backup-db.js",
    "backup-once": "node server/scripts/schedule-backup.js --once",
    "check-encoding": "node scripts/check-encoding.js",
    "test": "node scripts/check-encoding.js && node scripts/validate-syntax.js && node scripts/test-auth-middleware.js && node scripts/test-jersey-service.js && node scripts/test-security-config.js && node scripts/test-favorites-transaction.js && node scripts/test-favorites-route.js",
    "install-all": "npm install",
    "monitor": "node server/scripts/schedule-backup.js"
  },
  "keywords": [
    "cycling",
    "uci",
    "results",
    "api"
  ],
  "author": "Chen Peng",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cloudscraper": "^4.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "joi": "^17.13.3",
    "jsdom": "^29.1.1",
    "lark-cli": "^0.1.0",
    "mysql2": "^3.6.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "playwright-stealth": "^0.0.1",
    "puppeteer": "^24.43.1",
    "puppeteer-core": "^24.43.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "scrapingbee": "^1.8.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
