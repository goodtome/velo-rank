# ============================================================
# 正一领骑 - 环境变量模板
# 复制为 server/config/.env 并填入实际值
# ============================================================

# ----- 基础配置 -----
NODE_ENV=development
PORT=3000

# ----- 数据库（开发环境）-----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=jersey_db

# ----- 数据库（生产环境 / TiDB Cloud）-----
DB_HOST_PROD=your-tidb-host
DB_PORT_PROD=4000
DB_USER_PROD=your-tidb-user
DB_PASSWORD_PROD=your-tidb-password
DB_NAME_PROD=jersey_db

# ----- 安全配置 -----
# SESSION_SECRET: 生产环境必须使用强随机字符串（32 位以上）
#   生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production
# CORS_ORIGINS: 生产环境限制为小程序域名，逗号分隔
#   示例: https://servicewechat.com,https://xxx.servicewechat.com
CORS_ORIGINS=*
# ADMIN_API_KEY: 管理后台密钥（导入、同步等管理操作）
ADMIN_API_KEY=your-admin-key

# ----- 数据库连接池 -----
# 生产环境建议显式配置，避免无限排队或连接数过低
DB_POOL_CONNECTION_LIMIT=10
DB_POOL_MAX_IDLE=10
DB_POOL_QUEUE_LIMIT=100
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=10000
DB_KEEPALIVE_INITIAL_DELAY_MS=10000
# 某些一次性脚本如需跳过启动探活，可设为 1
DB_SKIP_BOOT_CHECK=0

# ----- 微信小程序 -----
WECHAT_APPID=your_appid
WECHAT_APPSECRET=your_appsecret
# 微信订阅消息模板 ID（推送功能使用）
WECHAT_TEMPLATE_RACE_START=
WECHAT_TEMPLATE_STAGE_END=
WECHAT_TEMPLATE_RANK_CHANGE=
WECHAT_TEMPLATE_KEY_EVENT=

# ----- PCS 爬虫 -----
PCS_BASE_URL=https://www.procyclingstats.com
PCS_REQUEST_INTERVAL=30000

# ----- ScraperAPI（绕过 Cloudflare）-----
# 注册地址: https://www.scraperapi.com/signup
# 免费额度: 1000 次请求/月
SCRAPERAPI_KEY=

# ----- 数据库备份 -----
BACKUP_DIR=./backups
BACKUP_DAYS=7
BACKUP_HOUR=3
