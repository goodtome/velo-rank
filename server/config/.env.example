# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=jersey_db

# 服务器配置
PORT=3000
NODE_ENV=development

# PCS爬取配置
PCS_BASE_URL=https://www.procyclingstats.com
PCS_REQUEST_INTERVAL=30000

# ScraperAPI配置（用于绕过Cloudflare）
# 注册地址: https://www.scraperapi.com/signup
# 免费额度: 1000次请求/月
SCRAPERAPI_KEY=your_scraperapi_key
